---
import { convertToSectionId } from '../_data/utils.ts';
import '../styles/layout/article.scss';
import OnThisPageNavigation from './OnThisPageNavigation.astro';

interface Section {
  title: string;
  component: any;
  componentProps?: any;
}

interface Props {
  title?: string;
  description?: string;
  sections: Section[];
}

const { title, description, sections = [] } = Astro.props;

const navItems = sections.map(section => ({
  id: `section-${convertToSectionId(section.title)}`,
  label: section.title,
}));
---
<div class="article-layout">

  <article class="article with-on-this-page">
    <wc-container size="lg">

        <header class="article-header">
          {Astro.slots.has('eyebrow') && <div class="article-eyebrow text-label-large"><slot name="eyebrow" /></div>}
          <h1 class="text-display-small article-title">{title}</h1>
          <div class="article-description text-body-large"><Fragment set:html={description}/></div>
          {Astro.slots.has('meta') && <div class="article-meta" data-pagefind-ignore="all"><slot name="meta" /></div>}
        </header>

        {
          sections.map((section) => (
            <section id={`section-${convertToSectionId(section.title)}`}
                class='section'>
              <h2 class='section-title heading-scrollable text-headline'>{section.title}</h2>

              <section.component {...section.componentProps} />
            </section>
          ))
        }

        <slot name="footer" />

    </wc-container>
  </article>

  <OnThisPageNavigation title={title} items={navItems} navId="article-on-this-page" />

  <script is:inline>
    // Adds each section's h3 headings under it. Headings inside a live demo are part of the
    // example, not the page outline.
    document.addEventListener('DOMContentLoaded', function () {
      const nav = document.getElementById('article-on-this-page');
      if (!nav) return;
      const items = [];
      document.querySelectorAll('.article .section').forEach(function (section) {
        const h2 = section.querySelector('h2.section-title');
        items.push({ id: section.id, label: h2 ? h2.textContent.trim() : section.id });
        section.querySelectorAll('h3').forEach(function (h3) {
          if (h3.closest('.demo-card')) return;
          if (!h3.id) {
            h3.id = 'sub-' + h3.textContent.trim().toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
          }
          items.push({ id: h3.id, label: h3.textContent.trim(), level: 2 });
        });
      });
      nav.items = items;
    });
  </script>
</div>
