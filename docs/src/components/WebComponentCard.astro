---
// A card on the Components overview. Styles live in styles/components.page.scss and match the
// Charts and Blocks overview cards: a wireframe preview on top, title link covering the card.
import { getTextTag } from '../_data/getLitComponentDetails.ts';
import ComponentPreview from './ComponentPreview.astro';

interface Props {
  component: any;
}

const { component } = Astro.props;
const rawTag: string = getTextTag(component, 'rawTag') ?? '';
const tag: string | null = getTextTag(component, 'tag');
---

{component && (
  <div class='component-card'>
    <div class='component-card-preview' aria-hidden='true'>
      <ComponentPreview name={rawTag} />
    </div>
    <div class='component-card-body'>
      <h3 class='component-card-title text-title-large'>
        <a class='component-card-link' href={`/components/${rawTag}/`}>{getTextTag(component, 'label')}</a>
        <span class='component-card-meta'>
          <wc-icon name='arrow_forward' aria-hidden='true'></wc-icon>
        </span>
      </h3>
      <p class='text-body-medium doc-muted'>{getTextTag(component, 'summary')}</p>
      {tag && <code class='text-label-medium'>{`<${tag}>`}</code>}
    </div>
  </div>
)}
