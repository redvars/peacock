---
const pathname = Astro.url.pathname;

const isComponentsPage =
  pathname === '/components' || pathname.startsWith('/components/');
const isChartsPage = pathname === '/charts' || pathname.startsWith('/charts/');
const isFoundationsPage = pathname === '/foundations' || pathname.startsWith('/foundations/');
const isFrameworksPage = pathname === '/frameworks' || pathname.startsWith('/frameworks/');
const isThemeBuilderPage = pathname === '/theme-builder';
const isBlogPage = pathname === '/blog' || pathname.startsWith('/blog/');
const isHomePage = pathname === '/';
const isBlocksPage = pathname === '/blocks' || pathname.startsWith('/blocks/');
---

<style lang="scss">
  .navigation-rail {
    position: fixed;
    --nav-rail-width: var(--side-navigation-width);
    --nav-rail-container-color: transparent;
  }
</style>

<wc-navigation-rail class="navigation-rail" data-pagefind-ignore="all">



  <wc-fab slot="header" id="search-btn"
        class="search-button"
        lowered
        color="primary"
        aria-label='Search components'
  ><wc-icon name="search"></wc-icon
  ></wc-fab>

  <wc-navigation-rail-item href="/#" aria-label='Go to Home' current={isHomePage ? true : null}>
    <img src="/assets/img/logo-plain.webp" slot="icon" class="logo" alt="peacock" style="width: 32px;">
    Home
  </wc-navigation-rail-item>
  <wc-navigation-rail-item href='/components' aria-label='Go to Components' current={isComponentsPage ? true : null}>
    <wc-icon slot="icon" name="settings"></wc-icon>
    Components
  </wc-navigation-rail-item>
  <wc-navigation-rail-item href='/charts/' aria-label='Go to Charts' current={isChartsPage ? true : null}>
    <wc-icon slot="icon" name="bar_chart"></wc-icon>
    Charts
  </wc-navigation-rail-item>
  <wc-navigation-rail-item href='/foundations/' aria-label='Go to Foundations' current={isFoundationsPage ? true : null}>
    <wc-icon slot="icon" name="palette"></wc-icon>
    Foundations
  </wc-navigation-rail-item>
  <wc-navigation-rail-item href='/frameworks/' aria-label='Go to Frameworks' current={isFrameworksPage ? true : null}>
    <wc-icon slot="icon" name="code"></wc-icon>
    Frameworks
  </wc-navigation-rail-item>
  <wc-navigation-rail-item href='/theme-builder' aria-label='Go to Theme builder' current={isThemeBuilderPage ? true : null}>
    <wc-icon slot="icon" name="format_paint"></wc-icon>
    Theme
  </wc-navigation-rail-item>

  <wc-navigation-rail-item href='/blog' title='Go to Blog' current={isBlogPage ? true : null}>
    <wc-icon slot="icon" name="pages"></wc-icon>
    Blog
  </wc-navigation-rail-item>

  <wc-navigation-rail-item href='/blocks' aria-label='Go to Blocks' current={isBlocksPage ? true : null}>
    <wc-icon slot="icon" name="grid_view"></wc-icon>
    Blocks
  </wc-navigation-rail-item>


  <wc-navigation-rail-item slot="footer" class="dir-switcher" aria-label='Toggle ltr/rtl direction'>
    <wc-icon slot="icon" class="icon"></wc-icon>
  </wc-navigation-rail-item>

  <wc-navigation-rail-item slot="footer" class="theme-switcher" aria-label='Toggle light/dark mode'>
    <wc-icon slot="icon" class="icon"></wc-icon>
  </wc-navigation-rail-item>
</wc-navigation-rail>
