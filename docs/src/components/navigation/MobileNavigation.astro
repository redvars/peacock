---
const pathname = Astro.url.pathname;
import { SITE_TITLE } from '../../siteconfig';
const isComponentsPage =
  pathname === '/components' || pathname.startsWith('/components/');
const isChartsPage = pathname === '/charts' || pathname.startsWith('/charts/');
const isFoundationsPage = pathname === '/foundations' || pathname.startsWith('/foundations/');
const isThemeBuilderPage = pathname === '/theme-builder';
const isBlogPage = pathname === '/blog' || pathname.startsWith('/blog/');
const isHomePage = pathname === '/';
const isBlocksPage = pathname === '/blocks' || pathname.startsWith('/blocks/');
---

<style>
  #hide-main-menu {
    margin-inline-start: -1.25rem;
    margin-block-start: -1rem;
  }
  #app-bar-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-on-surface);
    text-decoration: none;
  }
  #app-bar-title img {
    width: 22px;
  }
</style>

<header class="show-tablet-portrait-below" data-pagefind-ignore="all">
<wc-app-bar>
  <wc-icon-button slot="start" variant="text" id="show-main-menu">
    <wc-icon name="menu"></wc-icon>
  </wc-icon-button>

  <a id="app-bar-title" href="/">
    <img src="/assets/img/logo-plain.webp" class="logo" alt="peacock">
    {SITE_TITLE}
  </a>
  <wc-icon-button slot="end" variant="text"  class="search-button">
    <wc-icon name="search"></wc-icon>
  </wc-icon-button>
</wc-app-bar>
</header>

<wc-side-sheet id="main-menu-modal" variant="modal" placement="start" label="Main menu" class="show-tablet-portrait-below" data-pagefind-ignore="all">

  <wc-icon-button variant="text" id="hide-main-menu">
    <wc-icon name="close"></wc-icon>
  </wc-icon-button>

  <wc-list style="width: min(100%, 28rem);">

    <wc-list-item href="/#" aria-label='Go to Home' current={isHomePage ? true : null}>
      <img src="/assets/img/logo-plain.webp" slot="start" class="logo" alt="peacock" style="width: 32px;">
      Home
    </wc-list-item>
    <wc-list-item href='/components' aria-label='Go to Components' current={isComponentsPage ? true : null}>
      <wc-icon slot="start" name="settings"></wc-icon>
      Components
    </wc-list-item>
    <wc-list-item href='/charts/' aria-label='Go to Charts' current={isChartsPage ? true : null}>
      <wc-icon slot="start" name="bar_chart"></wc-icon>
      Charts
    </wc-list-item>
    <wc-list-item href='/foundations/' aria-label='Go to Foundations' current={isFoundationsPage ? true : null}>
      <wc-icon slot="start" name="palette"></wc-icon>
      Foundations
    </wc-list-item>
    <wc-list-item href='/theme-builder' aria-label='Go to Theme builder' current={isThemeBuilderPage ? true : null}>
      <wc-icon slot="start" name="format_paint"></wc-icon>
      Theme builder
    </wc-list-item>

    <wc-list-item href='/blog' title='Go to Blog' current={isBlogPage ? true : null}>
      <wc-icon slot="start" name="pages"></wc-icon>
      Blog
    </wc-list-item>

    <wc-list-item href='/blocks' aria-label='Go to Blocks' current={isBlocksPage ? true : null}>
      <wc-icon slot="start" name="grid_view"></wc-icon>
      Blocks
    </wc-list-item>


    <wc-list-item class="dir-switcher" aria-label='Toggle ltr/rtl direction' title='Go to Blog'>
      <wc-icon slot="start" class="icon"></wc-icon>
      Direction
    </wc-list-item>

    <wc-list-item class="theme-switcher" aria-label='Toggle light/dark mode'>
      <wc-icon slot="start" class="icon"></wc-icon>
      Theme
    </wc-list-item>

  </wc-list>
</wc-side-sheet>

<script>
  const $mainMenuModal = document.querySelector('#main-menu-modal');

  document.querySelector('#show-main-menu').addEventListener('click', () => {
    $mainMenuModal.show();
  });

  document.querySelector('#hide-main-menu').addEventListener('click', () => {
    $mainMenuModal.hide();
  });
</script>
