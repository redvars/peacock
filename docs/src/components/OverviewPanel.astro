---
import OnThisPageNavigation from './OnThisPageNavigation.astro';
interface Props {
  sections: any;
  title?: string;
}

const { sections, title } = Astro.props;

function sectionId(sectionTitle: string) {
  return `section-${sectionTitle.toLowerCase().replaceAll(' ', '-').replaceAll('/', '-')}`;
}

const navItems = sections.map((section: any) => ({
  id: sectionId(section.title),
  label: section.title,
}));
---
<div class='component-overview-tab'>
  <div class='component-content with-on-this-page'>

    {
      sections.map((section) => (
        <div id={sectionId(section.title)}
             class='component-section'>
          <h3 class='heading-scrollable text-headline-large'>{section.title}</h3>

          <section.Component/>
        </div>))
    }
  </div>
  <OnThisPageNavigation items={navItems} title={title} />
</div>
