---
// A static wireframe of a block for its card on the Blocks overview. Plain
// markup and CSS (styles/pages/blocks.scss), no components or scripts.
import type { BlockPreview } from '../_data/blocks';

interface Props {
  name: BlockPreview;
  icon: string;
}
const { name, icon } = Astro.props;
---

{name === 'dashboard' && (
  <div class='bp bp-dashboard'>
    <div class='bp-side'>
      <span class='bp-line bp-accent'></span>
      <span class='bp-line'></span>
      <span class='bp-line'></span>
      <span class='bp-line'></span>
    </div>
    <div class='bp-main'>
      <div class='bp-row'>
        <span class='bp-tile'></span><span class='bp-tile'></span><span class='bp-tile'></span>
      </div>
      <div class='bp-row bp-grow'>
        <span class='bp-panel bp-bars'><i></i><i></i><i></i><i></i><i></i></span>
        <span class='bp-panel bp-ring-holder'><span class='bp-ring'></span></span>
      </div>
    </div>
  </div>
)}

{(name === 'login' || name === 'signup') && (
  <div class='bp bp-auth'>
    <div class='bp-card'>
      <span class='bp-dot'></span>
      <span class='bp-line bp-short'></span>
      <span class='bp-field'></span>
      <span class='bp-field'></span>
      {name === 'signup' && <span class='bp-field'></span>}
      <span class='bp-button'></span>
    </div>
  </div>
)}

{name === 'settings' && (
  <div class='bp bp-settings'>
    <div class='bp-tabs'>
      <span class='bp-tab bp-active'></span><span class='bp-tab'></span><span class='bp-tab'></span>
    </div>
    <div class='bp-form'>
      <span class='bp-field'></span>
      <span class='bp-field'></span>
      <span class='bp-field bp-tall'></span>
      <div class='bp-row bp-end'>
        <span class='bp-button bp-ghost'></span><span class='bp-button'></span>
      </div>
    </div>
  </div>
)}

{name === 'data-table' && (
  <div class='bp bp-table'>
    <div class='bp-row'>
      <span class='bp-field bp-search'></span><span class='bp-button'></span>
    </div>
    <div class='bp-grid'>
      {Array.from({ length: 5 }, (_, row) => (
        <div class={row === 0 ? 'bp-tr bp-th' : 'bp-tr'}>
          <span></span><span></span><span></span><span class='bp-pill'></span>
        </div>
      ))}
    </div>
  </div>
)}

{name === 'two-factor' && (
  <div class='bp bp-auth bp-two-factor'>
    <div class='bp-card'>
      <span class='bp-dot'></span>
      <span class='bp-line bp-short'></span>
      <div class='bp-cells'><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <span class='bp-button'></span>
      <span class='bp-line bp-short'></span>
    </div>
  </div>
)}

{name === 'onboarding' && (
  <div class='bp bp-onboarding'>
    <div class='bp-steps'>
      <span class='bp-step bp-active'></span><i></i><span class='bp-step'></span><i></i><span class='bp-step'></span><i></i><span class='bp-step'></span>
    </div>
    <span class='bp-line bp-title'></span>
    <div class='bp-row'><span class='bp-field'></span><span class='bp-field'></span></div>
    <span class='bp-field bp-tall bp-drop'></span>
    <div class='bp-row bp-end'><span class='bp-button bp-ghost'></span><span class='bp-button'></span></div>
  </div>
)}

{name === 'pricing' && (
  <div class='bp bp-pricing'>
    <span class='bp-toggle'><i class='bp-active'></i><i></i></span>
    <div class='bp-row bp-grow'>
      {[0, 1, 2].map(plan => (
        <div class={plan === 1 ? 'bp-plan bp-featured' : 'bp-plan'}>
          <span class='bp-line bp-price'></span>
          <span class='bp-line'></span>
          <span class='bp-line'></span>
          <span class='bp-line'></span>
          <span class={plan === 1 ? 'bp-button' : 'bp-button bp-ghost'}></span>
        </div>
      ))}
    </div>
  </div>
)}

{name === 'record-detail' && (
  <div class='bp bp-record'>
    <div class='bp-record-head'>
      <span class='bp-avatar'></span>
      <div class='bp-record-title'><span class='bp-line'></span><span class='bp-pill'></span></div>
      <span class='bp-button bp-ghost'></span><span class='bp-button'></span>
    </div>
    <div class='bp-tabs'><span class='bp-tab bp-active'></span><span class='bp-tab'></span><span class='bp-tab'></span></div>
    <div class='bp-row'><span class='bp-tile'></span><span class='bp-tile'></span><span class='bp-tile'></span></div>
    <div class='bp-pairs'><span></span><span></span><span></span><span></span></div>
  </div>
)}

{name === 'app-shell' && (
  <div class='bp bp-app'>
    <div class='bp-appbar'>
      <span class='bp-logo'></span>
      <span class='bp-line'></span>
      <span class='bp-field bp-search'></span>
      <span class='bp-avatar'></span>
    </div>
    <div class='bp-app-body'>
      <div class='bp-side'>
        <span class='bp-field bp-workspace'></span>
        <span class='bp-line bp-accent'></span>
        <span class='bp-line'></span>
        <span class='bp-line'></span>
        <span class='bp-line'></span>
      </div>
      <div class='bp-main'>
        <span class='bp-line bp-title'></span>
        <div class='bp-row'>
          <span class='bp-tile'></span><span class='bp-tile'></span><span class='bp-tile'></span><span class='bp-tile'></span>
        </div>
        <div class='bp-row bp-grow'>
          <span class='bp-panel'></span><span class='bp-panel'></span>
        </div>
      </div>
    </div>
  </div>
)}

{name === 'kanban' && (
  <div class='bp bp-kanban'>
    <div class='bp-row bp-head'>
      <span class='bp-line'></span><span class='bp-button'></span>
    </div>
    <div class='bp-columns'>
      {[3, 2, 2, 1].map((count, column) => (
        <div class='bp-column'>
          <span class='bp-line bp-column-title'></span>
          {Array.from({ length: count }, (_, card) => (
            <span class={`bp-task bp-label-${(column + card) % 3}`}></span>
          ))}
        </div>
      ))}
    </div>
  </div>
)}

{name === 'calendar' && (
  <div class='bp bp-calendar'>
    <div class='bp-row bp-head'>
      <span class='bp-line'></span><span class='bp-button'></span>
    </div>
    <div class='bp-calendar-body'>
      <div class='bp-month'>
        {Array.from({ length: 35 }, (_, day) => (
          <span
            class={
              [3, 8, 9, 10, 16, 22, 25, 30].includes(day) ? 'bp-day bp-busy' : day === 12 ? 'bp-day bp-today' : 'bp-day'
            }
          ></span>
        ))}
      </div>
      <div class='bp-agenda'>
        <span class='bp-line bp-accent'></span>
        <span class='bp-line'></span>
        <span class='bp-line'></span>
        <span class='bp-line'></span>
      </div>
    </div>
  </div>
)}

{name === 'ticket' && (
  <div class='bp bp-ticket'>
    <div class='bp-ticket-main'>
      <span class='bp-line bp-title'></span>
      <span class='bp-line'></span>
      <span class='bp-line'></span>
      <div class='bp-comment'><span class='bp-avatar'></span><span class='bp-bubble'></span></div>
      <div class='bp-comment'><span class='bp-avatar'></span><span class='bp-bubble bp-note'></span></div>
      <span class='bp-field'></span>
    </div>
    <div class='bp-ticket-side'>
      <span class='bp-field'></span>
      <span class='bp-field'></span>
      <span class='bp-field'></span>
    </div>
  </div>
)}

{name === 'assistant' && (
  <div class='bp bp-assistant'>
    <div class='bp-assistant-page'>
      <span class='bp-line bp-title'></span>
      <span class='bp-line'></span>
      <div class='bp-assistant-tiles'><span></span><span></span><span></span></div>
    </div>
    <div class='bp-assistant-panel'>
      <span class='bp-assistant-ask'></span>
      <span class='bp-assistant-answer'></span>
      <span class='bp-assistant-draft'></span>
      <span class='bp-assistant-draft'></span>
      <span class='bp-assistant-composer'></span>
    </div>
  </div>
)}

{name === 'home-ai' && (
  <div class='bp bp-home-ai'>
    <span class='bp-home-ai-search'></span>
    <span class='bp-line bp-title'></span>
    <div class='bp-home-ai-row'>
      <span class='bp-home-ai-summary'></span>
      <span class='bp-home-ai-stat'></span>
    </div>
    <div class='bp-assistant-tiles'><span></span><span></span><span></span></div>
  </div>
)}

{name === 'incident-agent' && (
  <div class='bp bp-incident'>
    <div class='bp-incident-inbox'><span></span><span></span><span></span><span></span></div>
    <div class='bp-incident-thread'>
      <span class='bp-incident-event'></span>
      <span class='bp-incident-caller'></span>
      <span class='bp-incident-answer'></span>
      <span class='bp-incident-draft'></span>
      <span class='bp-incident-draft'></span>
      <span class='bp-incident-composer'></span>
    </div>
    <div class='bp-incident-record'>
      <span class='bp-line bp-title'></span>
      <span class='bp-field'></span>
      <span class='bp-field bp-incident-suggested'></span>
      <span class='bp-field bp-incident-suggested'></span>
      <span class='bp-field'></span>
    </div>
  </div>
)}

{name === 'agent-inbox' && (
  <div class='bp bp-agent-inbox'>
    <span class='bp-line bp-title'></span>
    <span class='bp-agent-inbox-summary'></span>
    <div class='bp-agent-inbox-cols'>
      <div class='bp-agent-inbox-col'><span></span><span></span><span></span></div>
      <div class='bp-agent-inbox-col'><span></span><span></span></div>
      <div class='bp-agent-inbox-col'><span></span><span></span><span></span></div>
    </div>
  </div>
)}

{name === 'landing' && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-line'></span><span class='bp-button'></span></div>
    <div class='bp-site-hero'>
      <div class='bp-site-copy'><span class='bp-line bp-title'></span><span class='bp-line'></span><span class='bp-button'></span></div>
      <span class='bp-site-media'></span>
    </div>
    <div class='bp-row'><span class='bp-tile'></span><span class='bp-tile'></span><span class='bp-tile'></span></div>
    <div class='bp-site-foot'><span></span><span></span><span></span><span></span></div>
  </div>
)}

{name === 'portal-home' && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-site-signin'></span></div>
    <div class='bp-site-search'><span class='bp-field'></span></div>
    <div class='bp-row bp-site-cards'><span class='bp-tile'></span><span class='bp-tile'></span><span class='bp-tile'></span><span class='bp-tile'></span></div>
    <div class='bp-site-split'><div><span class='bp-line'></span><span class='bp-line'></span><span class='bp-line'></span></div><span class='bp-tile'></span></div>
  </div>
)}

{/* ── Website ── */}

{name === 'product-page' && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-button'></span></div>
    <div class='bp-site-hero'>
      <div class='bp-site-copy'><span class='bp-line bp-title'></span><span class='bp-line'></span><span class='bp-button'></span></div>
      <span class='bp-site-media bp-site-video'><i></i></span>
    </div>
    <div class='bp-site-split bp-site-flip'><span class='bp-tile'></span><div><span class='bp-line'></span><span class='bp-line bp-short'></span></div></div>
    <div class='bp-row bp-site-quotes'><span class='bp-tile'></span><span class='bp-tile'></span><span class='bp-tile'></span></div>
    <div class='bp-site-dots'><i class='on'></i><i></i><i></i></div>
  </div>
)}

{name === 'blog-index' && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-button'></span></div>
    <div class='bp-site-chips'><i class='on'></i><i></i><i></i><i></i></div>
    <div class='bp-site-split'><span class='bp-site-media'></span><div><span class='bp-line bp-title'></span><span class='bp-line'></span><span class='bp-line bp-short'></span></div></div>
    <div class='bp-row bp-site-posts'><span class='bp-tile'></span><span class='bp-tile'></span><span class='bp-tile'></span></div>
  </div>
)}

{(name === 'blog-post' || name === 'legal-page') && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-button'></span></div>
    <div class='bp-site-article'>
      <div>
        <span class='bp-line bp-short'></span>
        <span class='bp-line bp-title'></span>
        {name === 'blog-post' ? <span class='bp-site-media'></span> : <span class='bp-site-note'></span>}
        <span class='bp-line'></span><span class='bp-line'></span><span class='bp-line bp-short'></span>
      </div>
      <div class='bp-site-toc'><span class='bp-line on'></span><span class='bp-line'></span><span class='bp-line'></span><span class='bp-line'></span></div>
    </div>
  </div>
)}

{name === 'docs-page' && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-button'></span></div>
    <div class='bp-site-docs'>
      <div class='bp-site-toc'><span class='bp-line'></span><span class='bp-line on'></span><span class='bp-line'></span><span class='bp-line'></span><span class='bp-line'></span></div>
      <div><span class='bp-line bp-title'></span><span class='bp-line'></span><span class='bp-site-note'></span><span class='bp-site-code'></span><span class='bp-line bp-short'></span></div>
      <div class='bp-site-toc'><span class='bp-line on'></span><span class='bp-line'></span><span class='bp-line'></span></div>
    </div>
  </div>
)}

{name === 'not-found' && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-button'></span></div>
    <div class='bp-site-center'>
      <span class='bp-site-404'>404</span>
      <span class='bp-line bp-title'></span>
      <span class='bp-field'></span>
      <div class='bp-row'><span class='bp-tile'></span><span class='bp-tile'></span><span class='bp-tile'></span></div>
    </div>
  </div>
)}

{name === 'waitlist' && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span></div>
    <div class='bp-site-hero'>
      <div class='bp-site-copy'><span class='bp-line bp-title'></span><span class='bp-site-check'></span><span class='bp-site-check'></span><span class='bp-site-check'></span></div>
      <div class='bp-site-form'><span class='bp-field'></span><span class='bp-field'></span><span class='bp-field'></span><span class='bp-button'></span></div>
    </div>
  </div>
)}

{/* ── Portals ── */}

{name === 'knowledge-article' && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-site-avatar'></span></div>
    <div class='bp-site-article'>
      <div>
        <span class='bp-line bp-short'></span>
        <span class='bp-line bp-title'></span>
        <span class='bp-site-step'><b>1</b><span class='bp-line'></span></span>
        <span class='bp-site-step'><b>2</b><span class='bp-line'></span></span>
        <span class='bp-site-step'><b>3</b><span class='bp-line'></span></span>
        <span class='bp-site-helpful'><span class='bp-line'></span><i></i><i></i></span>
      </div>
      <div class='bp-site-toc'><span class='bp-line'></span><span class='bp-line'></span><span class='bp-tile'></span></div>
    </div>
  </div>
)}

{name === 'search-results' && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-site-avatar'></span></div>
    <div class='bp-site-results'>
      <span class='bp-field'></span>
      <div class='bp-site-chips'><i class='on'></i><i></i><i></i></div>
      {[0, 1, 2].map(() => (
        <span class='bp-site-result'><span class='bp-line bp-short'></span><span class='bp-site-row'><i class='bp-site-mark-hl'></i><span class='bp-line'></span></span><span class='bp-site-row'><span class='bp-line'></span><i class='bp-site-mark-hl'></i></span></span>
      ))}
    </div>
  </div>
)}

{name === 'service-catalog' && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-site-avatar'></span></div>
    <div class='bp-site-sheet'>
      <div>
        <div class='bp-site-chips'><i class='on'></i><i></i><i></i></div>
        <div class='bp-row'><span class='bp-tile'></span><span class='bp-tile'></span></div>
        <div class='bp-row'><span class='bp-tile'></span><span class='bp-tile'></span></div>
      </div>
      <div class='bp-site-form'><span class='bp-line bp-title'></span><span class='bp-field'></span><span class='bp-field'></span><span class='bp-button'></span></div>
    </div>
  </div>
)}

{(name === 'my-cases' || name === 'org-members') && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-site-avatar'></span></div>
    <div class={name === 'org-members' ? 'bp-site-docs bp-site-admin' : 'bp-site-results'}>
      {name === 'org-members' && <div class='bp-site-toc'><span class='bp-line on'></span><span class='bp-line'></span><span class='bp-line'></span></div>}
      <div class='bp-site-results'>
        <span class='bp-site-row bp-site-head'><span class='bp-line bp-title'></span><span class='bp-button'></span></span>
        {[0, 1, 2, 3].map(i => (
          <span class='bp-site-row bp-site-trow'>
            {name === 'org-members' && <span class='bp-site-avatar'></span>}
            <span class='bp-line'></span>
            <i class={i === 1 ? 'bp-site-tag bp-site-tag-alt' : 'bp-site-tag'}></i>
          </span>
        ))}
      </div>
    </div>
  </div>
)}

{name === 'downloads' && (
  <div class='bp bp-site'>
    <div class='bp-site-bar'><i class='bp-site-mark'></i><span class='bp-line'></span><span class='bp-line'></span><span class='bp-site-avatar'></span></div>
    <div class='bp-site-results'>
      <span class='bp-site-release'>
        <span class='bp-line bp-title'></span>
        <span class='bp-site-chips'><i class='on'></i><i></i><i></i></span>
        <span class='bp-site-row'><span class='bp-button'></span><span class='bp-site-code'></span></span>
      </span>
      <span class='bp-site-row'><span class='bp-site-code'></span><i class='bp-site-copy'></i></span>
      <span class='bp-line'></span><span class='bp-line bp-short'></span>
    </div>
  </div>
)}

{name === 'oidc-sign-in' && (
  <div class='bp bp-auth'>
    <div class='bp-card'>
      <span class='bp-dot'></span>
      <span class='bp-line bp-short'></span>
      <span class='bp-field bp-provider'></span>
      <span class='bp-field bp-provider'></span>
      <span class='bp-line bp-or'></span>
      <span class='bp-field'></span>
      <span class='bp-button'></span>
    </div>
  </div>
)}

{!['dashboard', 'login', 'signup', 'settings', 'data-table', 'two-factor', 'onboarding', 'pricing', 'record-detail', 'app-shell', 'kanban', 'calendar', 'ticket', 'assistant', 'home-ai', 'incident-agent', 'agent-inbox', 'landing', 'portal-home', 'product-page', 'blog-index', 'blog-post', 'docs-page', 'legal-page', 'not-found', 'waitlist', 'knowledge-article', 'search-results', 'service-catalog', 'my-cases', 'org-members', 'downloads', 'oidc-sign-in'].includes(name) && (
  <wc-icon class='bp-fallback' name={icon}></wc-icon>
)}
