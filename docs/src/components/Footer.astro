---
// The site footer: brand and mission with social links, three columns of links (docs,
// resources, project), then a bottom bar. Styles: styles/footer.scss.
import { AUTHOR, REPO_URL, NPM_VERSIONS_URL, PRIVACY_URL, LICENSE_URL, NPM_URL, VERSION, SITE_TITLE } from '../siteconfig';
import GitHubStars from './GitHubStars.astro';
import '../styles/footer.scss';

const columns = [
  {
    title: 'Docs',
    links: [
      { label: 'Components', href: '/components/' },
      { label: 'Charts', href: '/charts/' },
      { label: 'Diagrams', href: '/diagrams/' },
      { label: 'AI', href: '/ai/' },
      { label: 'Blocks', href: '/blocks/' },
      { label: 'Foundations', href: '/foundations/' },
      { label: 'Frameworks', href: '/frameworks/' },
      { label: 'Theme builder', href: '/theme-builder' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Getting started', href: '/#getting-started' },
      { label: 'Blog', href: '/blog/' },
      { label: 'Migrating to 4.0', href: `${REPO_URL}/blob/main/MIGRATION.md`, external: true },
      { label: 'Versions', href: NPM_VERSIONS_URL, external: true },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: REPO_URL, external: true },
      { label: 'Report an issue', href: `${REPO_URL}/issues/new`, external: true },
      { label: 'npm package', href: NPM_URL, external: true },
      { label: 'License', href: LICENSE_URL },
      { label: 'Privacy policy', href: PRIVACY_URL },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class='site-footer' data-pagefind-ignore='all'>
  <div class='site-footer-main'>
    <section class='site-footer-brand' aria-label={`About ${SITE_TITLE}`}>
      <a class='site-footer-logo' href='/'>
        <img src='/assets/img/logo-plain.webp' alt='' width='40' height='40' />
        <span class='site-footer-name'>{SITE_TITLE}</span>
      </a>
      <p class='text-body-medium site-footer-muted'>
        Accessible, themeable web components for product interfaces. Built with Lit, usable everywhere.
      </p>
      <div class='site-footer-badges'>
        <a class='site-footer-version text-label-medium' href={NPM_URL} target='_blank' rel='noopener'>
          <wc-icon name='deployed_code' aria-hidden='true'></wc-icon>
          v{VERSION} on npm
        </a>
        <GitHubStars />
      </div>
      <ul class='site-footer-social' aria-label='Social links'>
        <li>
          <wc-icon-button variant='outlined' color='surface' href={`https://x.com/${AUTHOR.twitter}`} target='_blank' aria-label='X'>
            <wc-icon name='logo--x' provider='carbon'></wc-icon>
          </wc-icon-button>
        </li>
      </ul>
    </section>

    {columns.map(column => (
      <nav class='site-footer-column' aria-label={column.title}>
        <h2 class='text-title-small site-footer-heading'>{column.title}</h2>
        <ul>
          {column.links.map(link => (
            <li>
              <a
                class='text-body-medium'
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener' : undefined}
              >
                {link.label}
                {link.external && <wc-icon name='arrow_outward' aria-hidden='true'></wc-icon>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class='site-footer-bottom text-body-small'>
    <span>© {year} <a href={AUTHOR.url} target='_blank' rel='noopener'>{AUTHOR.name}</a>. Released under the MIT license.</span>
    <span>Built with <a href='https://lit.dev' target='_blank' rel='noopener'>Lit</a> · Made in India</span>
  </div>
</footer>
