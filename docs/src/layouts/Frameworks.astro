---
import Layout from './WithSidebar.astro';
import Footer from '../components/Footer.astro';
import DocPager from '../components/DocPager.astro';
import { FRAMEWORK_PAGES } from '../_data/frameworks.ts';
// The Frameworks pages share the Foundations page styles.
import '../styles/pages/foundations.scss';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const index = FRAMEWORK_PAGES.findIndex(page => page.href === pathname);
const previous = index > 0 ? FRAMEWORK_PAGES[index - 1] : undefined;
const next = index >= 0 ? FRAMEWORK_PAGES[index + 1] : undefined;
---

<Layout title={index === 0 ? title : `${title} · Frameworks`} description={description} sidebarItems={FRAMEWORK_PAGES}>
  <article class='foundation-page'>
    <header class='foundation-header'>
      {index !== 0 && <a class='text-label-large foundation-eyebrow' href='/frameworks/'>Frameworks</a>}
      <h1 class='text-display-small'>{title}</h1>
      <p class='text-body-large foundation-lede'>{description}</p>
    </header>

    <slot />

    <DocPager label='Frameworks' previous={previous} next={next} />
  </article>

  <Footer />
</Layout>
