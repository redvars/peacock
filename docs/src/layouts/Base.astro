---
// The root HTML shell: search and social metadata (title, description, canonical, Open Graph,
// Twitter card, JSON-LD from _data/seo.ts), fonts, analytics and the Peacock styles and loader.
import GoogleTagManager from '../components/GoogleTagManager.astro';
import '../styles/layout/base.scss';
import { getScriptUrl, getFallbackScriptUrl, getThemeCssUrl } from '../_data/utils.ts';
import {
  SITE_TITLE,
  SITE_TAGLINE,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SOCIAL_IMAGE,
  AUTHOR,
  GOOGLE_TAG_MANAGER_ID,
} from '../siteconfig';
import {
  getCanonicalUrl,
  getPageGraph,
  serializeJsonLd,
  toPlainText,
  truncateDescription,
  type PageSeo,
} from '../_data/seo';

interface Props {
  title?: string;
  description?: string | null;
  keywords?: string;
  seo?: PageSeo;
}

const { title, description, keywords, seo = {} } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === '/';

const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · ${SITE_TAGLINE}`;
const pageDescription = truncateDescription(toPlainText(description) || SITE_DESCRIPTION);
const canonicalURL = getCanonicalUrl(pathname, Astro.site);
const image = seo.image ?? SOCIAL_IMAGE;
const imageURL = new URL(image.src, Astro.site).href;
const ogType = seo.type ?? (isHome ? 'website' : 'article');
const keywordList = [title, keywords].filter(Boolean).join(', ');
const jsonLd = serializeJsonLd(
  getPageGraph({ pathname, title, description: pageDescription, image: imageURL, seo }),
);

const isProd = import.meta.env.PROD;
---

<!DOCTYPE html>
<html lang='en'>
<head>
  <!-- Required Meta Tags Always Come First -->
  <meta charset="utf-8"/>
  <meta name='viewport' content='width=device-width, initial-scale=1, shrink-to-fit=no' />

  <title>{pageTitle}</title>
  <meta name='description' content={pageDescription} />
  {keywordList && <meta name='keywords' content={keywordList} />}
  <link rel='canonical' href={canonicalURL} />
  <meta name='robots' content={seo.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name='color-scheme' content='light dark' />
  <meta name='theme-color' content='#ffffff' media='(prefers-color-scheme: light)' />
  <meta name='theme-color' content='#121212' media='(prefers-color-scheme: dark)' />

  <!-- Author Meta Tags -->
  <meta name='author' content={AUTHOR.name} />
  <meta name='copyright' content={`(c) ${new Date().getFullYear()} ${AUTHOR.name}`} />

  <!-- Open Graph -->
  <meta property='og:site_name' content={SITE_TITLE} />
  <meta property='og:locale' content={SITE_LOCALE} />
  <meta property='og:type' content={ogType} />
  <meta property='og:title' content={pageTitle} />
  <meta property='og:description' content={pageDescription} />
  <meta property='og:url' content={canonicalURL} />
  <meta property='og:image' content={imageURL} />
  {image.width && <meta property='og:image:width' content={String(image.width)} />}
  {image.height && <meta property='og:image:height' content={String(image.height)} />}
  {image.alt && <meta property='og:image:alt' content={image.alt} />}
  {seo.publishedDate && <meta property='article:published_time' content={seo.publishedDate} />}

  <!-- Twitter card -->
  <meta name='twitter:card' content='summary_large_image' />
  <meta name='twitter:site' content={`@${AUTHOR.twitter}`} />
  <meta name='twitter:title' content={pageTitle} />
  <meta name='twitter:description' content={pageDescription} />
  <meta name='twitter:image' content={imageURL} />
  {image.alt && <meta name='twitter:image:alt' content={image.alt} />}

  <!-- Structured data -->
  <script is:inline type='application/ld+json' set:html={jsonLd}></script>

  <!--
    Yjs is a peer dependency of wc-document-editor's collaboration (the app and the editor must
    share one copy). The docs have no bundler, so map it here, before any module script loads.
  -->
  <script is:inline type="importmap">
    { "imports": { "yjs": "https://cdn.jsdelivr.net/npm/yjs@13.6.33/+esm" } }
  </script>
  <link rel="sitemap" href="/sitemap-index.xml" />

  <GoogleTagManager id={GOOGLE_TAG_MANAGER_ID} />

  <!-- Favicon -->
  <link rel='icon' href='/favicon.svg' type='image/svg+xml' />
  <link rel='icon' href='/assets/img/favicon.png' type='image/png' />
  <link rel='apple-touch-icon' href='/assets/img/logo.png' />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@100..900&family=Pacifico&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

  <!-- Peacock styles -->
  {isProd ?
    (
    <link href={getThemeCssUrl()} rel="stylesheet" />
    )
    :
    (
    <link href="/assets/peacock/assets/styles.css" rel="stylesheet" />
    )
  }


</head>
<body>

<slot />

<!-- Peacock scripts -->
{isProd ?
  (
  <script
      type="module"
      src={getScriptUrl()}
      onerror={`let s=document.createElement('script'); s.type='module'; s.src='${getFallbackScriptUrl()}'; document.head.appendChild(s);`}>
      </script>
  )
  :
  (
  <script
      type="module"
      src="/assets/peacock/loader.js"></script>
  )
}
</body>
</html>
