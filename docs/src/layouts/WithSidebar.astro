---
import Layout from './Default.astro';
import type { PageSeo } from '../_data/seo';
import '../styles/layout/with-sidebar.scss';
const pathname = Astro.url.pathname;

type SidebarMenuItem = {
  label: string;
  href: string;
};

type SidebarMenuGroup = {
  label: string;
  items: SidebarMenuItem[];
};

interface Props {
  title: string;
  description?: string | null;
  /** Search and social metadata beyond the title and description (see _data/seo.ts). */
  seo?: PageSeo;
  sidebarItems?: SidebarMenuItem[];
  /** Collapsible groups after the items. The group holding the current page starts expanded. */
  sidebarGroups?: SidebarMenuGroup[];
}
const {title, description, seo, sidebarItems = [], sidebarGroups = []} = Astro.props;



---
<Layout title={title} description={description} seo={seo}>

  <div class="with-sidebar-layout">

    <div class='sidenav-container' data-pagefind-ignore="all">
      <wc-navigation-drawer class='sidenav' open>
        {
            sidebarItems.map((item) => {
              return <wc-navigation-drawer-item
              value={item.href}
              href={item.href}
              current={item.href === pathname ? true : null}>{item.label}</wc-navigation-drawer-item>
            })
        }
        {
            sidebarGroups.map((group) => (
              <wc-navigation-drawer-group expanded={group.items.some(item => item.href === pathname) ? true : null}>
                <span slot='label'>{group.label}</span>
                {group.items.map((item) => (
                  <wc-navigation-drawer-item
                    value={item.href}
                    href={item.href}
                    current={item.href === pathname ? true : null}>{item.label}</wc-navigation-drawer-item>
                ))}
              </wc-navigation-drawer-group>
            ))
        }
      </wc-navigation-drawer>
    </div>

    <div class='with-sidebar-layout-content'>
      <slot/>
    </div>
  </div>

</Layout>
