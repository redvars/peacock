---
import Layout from './Default.astro';
import '../styles/layout/with-sidebar.scss';
const pathname = Astro.url.pathname;

type SidebarMenuItem = {
  label: string;
  href: string;
};

interface Props {
  title: string;
  description?: string;
  sidebarItems?: SidebarMenuItem[];
}
const {title, description, sidebarItems = []} = Astro.props;



---
<Layout title={title} description={description}>

  <div class="with-sidebar-layout">

    <div class='sidenav-container'>
      <wc-navigation-drawer class='sidenav' open>
        {
            sidebarItems.map((item) => {
              return <wc-navigation-drawer-item
              value={item.href}
              href={item.href}
              current={item.href === pathname ? true : null}>{item.label}</wc-navigation-drawer-item>
            })
        }
      </wc-navigation-drawer>
    </div>

    <div class='with-sidebar-layout-content'>
      <slot/>
    </div>
  </div>

</Layout>
