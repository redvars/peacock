---
import Layout from './WithSidebar.astro';
import Footer from '../components/Footer.astro';
import DocPager from '../components/DocPager.astro';
import { AUTHOR } from '../siteconfig';
import { formatPostDate, getPosts } from '../_data/blog';
import '../styles/layout/doc-page.scss';
import '../styles/pages/blog.scss';

interface Props {
  title: string;
  description: string;
  publishedDate: string;
  author?: string;
  tags?: string[];
}

const { title, description, publishedDate, author = AUTHOR.name, tags = [] } = Astro.props;

const posts = getPosts();
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const index = posts.findIndex(post => post.href === pathname);
// Posts are newest first: "previous" is the older post, "next" the newer one.
const older = index >= 0 ? posts[index + 1] : undefined;
const newer = index > 0 ? posts[index - 1] : undefined;

const sidebarItems = [{ label: 'All posts', href: '/blog/' }, ...posts.map(post => ({ label: post.title, href: post.href }))];
---

<Layout title={`${title} · Blog`} description={description} sidebarItems={sidebarItems}>
  <article class='doc-page'>
    <header class='doc-header'>
      <a class='text-label-large doc-eyebrow' href='/blog/'>Blog</a>
      <h1 class='text-display-small'>{title}</h1>
      <div class='post-meta text-body-medium'>
        <time datetime={publishedDate}>{formatPostDate(publishedDate)}</time>
        <span aria-hidden='true'>·</span>
        <span>{author}</span>
      </div>
      {tags.length > 0 && (
        <div class='post-tags'>
          {tags.map(tag => <wc-tag size='sm'>{tag}</wc-tag>)}
        </div>
      )}
    </header>

    <div class='post-body text-body-large'>
      <slot />
    </div>

    <DocPager
      label='Blog'
      previousCaption='Older post'
      nextCaption='Newer post'
      previous={older && { label: older.title, href: older.href }}
      next={newer && { label: newer.title, href: newer.href }}
    />
  </article>

  <Footer />
</Layout>
