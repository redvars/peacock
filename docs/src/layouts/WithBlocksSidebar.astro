---
import Layout from './WithSidebar.astro';
import Footer from '../components/Footer.astro';
import DocPager from '../components/DocPager.astro';
import { BLOCKS, BLOCKS_OVERVIEW } from '../_data/blocks';
import '../styles/layout/doc-page.scss';
import '../styles/pages/blocks.scss';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isOverview = pathname === BLOCKS_OVERVIEW.href;

const sidebarItems = [
  { label: BLOCKS_OVERVIEW.label, href: BLOCKS_OVERVIEW.href },
  ...BLOCKS.map(block => ({ label: block.label, href: block.href })),
];

const index = BLOCKS.findIndex(block => block.href === pathname);
const previous = index > 0 ? BLOCKS[index - 1] : undefined;
const next = index >= 0 ? BLOCKS[index + 1] : undefined;
---

<Layout title={isOverview ? title : `${title} · Blocks`} description={description} sidebarItems={sidebarItems}>
  <article class='doc-page blocks-page'>
    <header class='doc-header'>
      {!isOverview && <a class='text-label-large doc-eyebrow' href={BLOCKS_OVERVIEW.href}>Blocks</a>}
      <h1 class='text-display-small'>{title}</h1>
      <p class='text-body-large doc-muted'>{description}</p>
    </header>

    <slot />

    <DocPager
      label='Blocks'
      previous={previous && { label: previous.label, href: previous.href, description: previous.summary }}
      next={next && { label: next.label, href: next.href, description: next.summary }}
    />
  </article>

  <Footer />
</Layout>
