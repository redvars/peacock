---
import Layout from './Base.astro';
import SideNavigation from '../components/navigation/SideNavigation.astro';
import MobileNavigation from '../components/navigation/MobileNavigation.astro';
import SiteSearch from '../components/navigation/SiteSearch.astro';
import type { PageSeo } from '../_data/seo';
import '../styles/layout/default.scss';

interface Props {
  title?: string;
  description?: string | null;
  keywords?: string;
  /** Search and social metadata beyond the title and description (see _data/seo.ts). */
  seo?: PageSeo;
}


const {
  title,
  description,
  keywords,
  seo,
} = Astro.props;
---

<Layout title={title} description={description} keywords={keywords} seo={seo}>

  <div class="default-layout">

    <!-- For desktop and tablet -->
    <div class='side-navigation-container'>
      <SideNavigation/>
    </div>


    <div class="default-layout-content">

       <!-- For mobile -->
      <MobileNavigation />

      <slot />
    </div>
  </div>

  <wc-notification-manager placement='bottom-end' class="page-notification-manager"></wc-notification-manager>

  <SiteSearch />


  <!-- Scripts -->
  <script src="/assets/js/main.js" is:inline></script>

</Layout>
