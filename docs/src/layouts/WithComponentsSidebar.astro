---
// The Components section frame: the sidebar lists the components under the gallery's groups
// (_data/componentGroups.ts), with the group of the current page expanded.
import Layout from './WithSidebar.astro';
import Footer from '../components/Footer.astro';
import { getGroupedComponents } from '../_data/componentGroups.ts';

interface Props {
  description?: string;
  title: string;
  classes?: string;
}

const { description, title } = Astro.props;

const sidebarItems = [{ label: 'Overview', href: '/components/' }];
const sidebarGroups = getGroupedComponents().map(group => ({
  label: group.name,
  items: group.entries.map(entry => ({
    label: entry.label ?? entry.rawTag,
    href: `/components/${entry.rawTag}/`,
  })),
}));
---

<Layout title={title} description={description} sidebarItems={sidebarItems} sidebarGroups={sidebarGroups}>
  <div class='with-components-sidebar-layout'>
    <slot />

    <div class='footer'>
      <Footer />
    </div>
  </div>
</Layout>
