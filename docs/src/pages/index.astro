---
// The home page: hero with a live demo and install tabs, numbers computed at build time, the
// sections of the site, the component groups, frameworks, theming, getting started and the
// latest post. Styles: styles/pages/index.scss.
import Layout from '../layouts/Default.astro';
import '../styles/pages/index.scss';
import Footer from '../components/Footer.astro';
import GitHubStars from '../components/GitHubStars.astro';
import { getCdnUrl, getScriptUrl, getThemeCssUrl } from '../_data/utils.ts';
import { getGroupedComponents } from '../_data/componentGroups.ts';
import { CHARTS } from '../_data/charts';
import { BLOCKS } from '../_data/blocks';
import { getPosts } from '../_data/blog';
import { SITE_DESCRIPTION, NPM_PACKAGE } from '../siteconfig';
import { getSoftwareNode } from '../_data/seo';

const groups = getGroupedComponents();
const componentCount = groups.reduce((total, group) => total + group.entries.length, 0);
const latestPost = getPosts()[0];

const stats = [
  { value: `${componentCount}`, label: 'Components' },
  { value: `${CHARTS.length}`, label: 'Chart types' },
  { value: `${BLOCKS.length}`, label: 'Page blocks' },
  { value: '3', label: 'Framework packages' },
  { value: 'MIT', label: 'License' },
];

const explore = [
  {
    href: '/components/',
    icon: 'widgets',
    title: 'Components',
    text: `${componentCount} elements for fields, data, navigation, overlays, feedback and the assistant.`,
  },
  {
    href: '/charts/',
    icon: 'bar_chart',
    title: 'Charts',
    text: 'Bar, line, area, pie and doughnut charts that follow your theme.',
  },
  {
    href: '/blocks/',
    icon: 'dashboard',
    title: 'Blocks',
    text: 'Whole screens such as dashboards, sign-in, settings and an assistant panel, ready to copy.',
  },
  {
    href: '/foundations/',
    icon: 'palette',
    title: 'Foundations',
    text: 'The color, shape, type, motion and spacing tokens behind every component.',
  },
  {
    href: '/frameworks/',
    icon: 'code',
    title: 'Frameworks',
    text: 'Typed React, Vue and Angular components with two-way binding.',
  },
  {
    href: '/theme-builder',
    icon: 'format_paint',
    title: 'Theme builder',
    text: 'Pick a color, shape and fonts, and get a theme for your brand.',
  },
];

const install = [
  {
    label: 'HTML',
    language: 'html',
    value: `<link rel="stylesheet" href="${getThemeCssUrl()}" />\n<script type="module" src="${getScriptUrl()}"></script>\n\n<wc-button>Click me</wc-button>`,
  },
  { label: 'npm', language: 'bash', value: `npm install ${NPM_PACKAGE}` },
  { label: 'React', language: 'bash', value: `npm install ${NPM_PACKAGE} ${NPM_PACKAGE}-react` },
  { label: 'Vue', language: 'bash', value: `npm install ${NPM_PACKAGE} ${NPM_PACKAGE}-vue` },
  { label: 'Angular', language: 'bash', value: `npm install ${NPM_PACKAGE} ${NPM_PACKAGE}-angular` },
];

const frameworkExamples = [
  {
    label: 'React',
    language: 'tsx',
    value: `import { useState } from 'react';
import { Button, Input } from '@redvars/peacock-react';

export function Invite() {
  const [email, setEmail] = useState('');
  return (
    <>
      <Input label="Email" value={email} onInput={e => setEmail(e.detail.value)} />
      <Button onClick={() => send(email)}>Send invite</Button>
    </>
  );
}`,
  },
  {
    label: 'Vue',
    language: 'vue',
    value: `<script setup lang="ts">
import { ref } from 'vue';
import { WcButton, WcInput } from '@redvars/peacock-vue';

const email = ref('');
</script>

<template>
  <WcInput label="Email" v-model="email" />
  <WcButton @click="send(email)">Send invite</WcButton>
</template>`,
  },
  {
    label: 'Angular',
    language: 'typescript',
    value: `import { Component } from '@angular/core';
import { FormsModule } from '@angular/forms';
import { PEACOCK_COMPONENTS } from '@redvars/peacock-angular';

@Component({
  selector: 'app-invite',
  imports: [FormsModule, ...PEACOCK_COMPONENTS],
  template: \`
    <wc-input label="Email" [(ngModel)]="email"></wc-input>
    <wc-button (click)="send(email)">Send invite</wc-button>
  \`,
})
export class Invite {
  email = '';
}`,
  },
];

const fonts =
  'https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@100..900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap';

const gettingStarted = [
  {
    label: 'Whole library',
    language: 'html',
    value: `<head>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="${fonts}">

  <!-- The default theme. Replace it with one from the theme builder. -->
  <link rel="stylesheet" href="${getThemeCssUrl()}">
  <!-- Registers each Peacock tag the page uses, loading only those components. -->
  <script type="module" src="${getScriptUrl()}"></script>
</head>

<body>
  <wc-button size="lg" color="primary">Click me</wc-button>
</body>`,
  },
  {
    label: 'One component',
    language: 'html',
    value: `<head>
  <link rel="stylesheet" href="${getThemeCssUrl()}">

  <script type="module">
    import { Button } from '${getCdnUrl('dist/button.js')}';
    // The class is not registered: define it under the tag you want.
    customElements.define('my-button', Button);
  </script>
</head>

<body>
  <my-button size="lg" color="primary">Click me</my-button>
</body>`,
  },
  {
    label: 'Custom theme',
    language: 'javascript',
    value: `// With a bundler: npm install ${NPM_PACKAGE}
import { applyTheme } from '${NPM_PACKAGE}/theme';
// Without one, import it from the CDN instead:
// import { applyTheme } from '${getCdnUrl('dist/assets/theme.js')}';

// Settings you leave out keep their defaults.
await applyTheme({
  primary: '#0b57d0',
  variant: 'tonalSpot',
  contrast: 'standard',
  shape: 'rounded',
  font: { brand: 'Poppins', plain: 'Inter' },
});`,
  },
];

const keywords = 'web components, design system, lit, react components, vue components, angular components, ui library, button, input, select, table, data grid, calendar, date picker, modal, tabs, menu, charts, dashboard, theme builder, accessibility, right-to-left, ai components, assistant, chat ui, generative ui';
---

<Layout keywords={keywords} seo={{ type: 'website', jsonLd: [getSoftwareNode()] }}>
  <div class='home'>

    <!-- Hero -->
    <section class='home-hero'>
      <div class='home-hero-text'>
        <a class='home-announcement text-label-large' href={latestPost?.href ?? '/blog/'}>
          <span class='home-announcement-badge'>New</span>
          {latestPost?.title ?? 'Read the blog'}
          <wc-icon name='arrow_forward' aria-hidden='true'></wc-icon>
        </a>

        <h1 class='home-title text-display-large'>
          Build product interfaces <span class='home-title-accent'>with web components.</span>
        </h1>
        <p class='home-lede text-title-large'>{SITE_DESCRIPTION}</p>

        <div class='home-actions'>
          <wc-link-button href='#getting-started' level='primary'>Get started</wc-link-button>
          <wc-link-button href='/components/' level='secondary' variant='tonal'>Browse components</wc-link-button>
          <GitHubStars variant='button' />
        </div>

        <div class='home-install'>
          <wc-code-group>
            {install.map(tab => (
              <wc-code-highlighter label={tab.label} language={tab.language} value={tab.value} format='false'></wc-code-highlighter>
            ))}
          </wc-code-group>
        </div>
      </div>

      <div class='home-hero-demo' aria-label='A live example built with Peacock components'>
        <wc-card class='home-demo-card' variant='elevated'>
          <wc-card-content class='home-demo-body'>
            <div class='home-demo-header'>
              <div>
                <div class='text-title-large'>Invite to workspace</div>
                <div class='text-body-medium home-muted'>They get an email with a sign-in link.</div>
              </div>
              <wc-avatar-group>
                <wc-avatar name='Ada Lovelace'></wc-avatar>
                <wc-avatar name='Grace Hopper'></wc-avatar>
                <wc-avatar name='Alan Turing'></wc-avatar>
              </wc-avatar-group>
            </div>
            <wc-input label='Email' type='email' placeholder='name@company.com' value='grace@example.com'></wc-input>
            <wc-select label='Role' value='editor'>
              <wc-option value='viewer'>Viewer</wc-option>
              <wc-option value='editor'>Editor</wc-option>
              <wc-option value='admin'>Admin</wc-option>
            </wc-select>
            <wc-switch checked>Send a welcome email</wc-switch>
            <div class='home-demo-actions'>
              <wc-button variant='text'>Cancel</wc-button>
              <wc-button level='primary'>Send invite</wc-button>
            </div>
          </wc-card-content>
        </wc-card>
        <div class='home-demo-stats'>
          <wc-stat variant='filled' label='Seats used' value='42' previous='37'></wc-stat>
          <wc-stat variant='filled' label='Pending invites' value='5' previous='8'></wc-stat>
        </div>
      </div>
    </section>

    <!-- Numbers -->
    <section class='home-stats' aria-label='Peacock in numbers'>
      {stats.map(stat => (
        <div class='home-stat'>
          <span class='home-stat-value text-display-small'>{stat.value}</span>
          <span class='home-stat-label text-label-large'>{stat.label}</span>
        </div>
      ))}
    </section>

    <!-- Explore -->
    <section class='home-section' aria-labelledby='explore'>
      <header class='home-section-header'>
        <h2 id='explore' class='text-headline-large'>Everything you need for an app</h2>
        <p class='text-body-large home-muted'>Components, charts and whole screens, all built on one set of tokens.</p>
      </header>
      <div class='home-explore'>
        {explore.map(card => (
          <a class='home-explore-card' href={card.href}>
            <span class='home-explore-icon'><wc-icon name={card.icon} aria-hidden='true'></wc-icon></span>
            <span class='text-title-large'>{card.title}</span>
            <span class='text-body-medium home-muted'>{card.text}</span>
            <span class='home-explore-more text-label-large'>
              Explore <wc-icon name='arrow_forward' aria-hidden='true'></wc-icon>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Component groups -->
    <section class='home-section' aria-labelledby='component-groups'>
      <header class='home-section-header'>
        <h2 id='component-groups' class='text-headline-large'>Components by purpose</h2>
        <p class='text-body-large home-muted'>
          The same events, sizes and words on every component, with form validation, keyboard support,
          right-to-left layouts and translatable text.
        </p>
      </header>
      <div class='home-groups'>
        {groups.map(group => (
          <a class='home-group' href={`/components/#${group.id}`}>
            <span class='text-label-large'>{group.name}</span>
            <span class='home-group-count text-label-medium'>{group.entries.length}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- AI -->
    <section class='home-section home-split home-ai' aria-labelledby='ai-native'>
      <header class='home-section-header'>
        <h2 id='ai-native' class='text-headline-large'>AI native, never AI only</h2>
        <p class='text-body-large home-muted'>
          Components for an assistant that works inside your app: summaries that cite their sources, a
          chat panel, suggested values and drafts the person confirms, answers shown as charts and tables.
          Peacock never calls a model. Your app registers one provider with <code>setPeacockAi()</code>,
          and turning AI off removes every trace of it while the page keeps working.
        </p>
        <ul class='home-ai-points text-body-medium'>
          <li><wc-icon name='label' aria-hidden='true'></wc-icon>Everything the assistant wrote is marked, and shows why.</li>
          <li><wc-icon name='task_alt' aria-hidden='true'></wc-icon>It never writes on its own: values are suggestions, records are drafts.</li>
          <li><wc-icon name='shield' aria-hidden='true'></wc-icon>Model text is shown as text, never run; sensitive fields never reach it.</li>
        </ul>
        <div class='home-links'>
          <wc-link href='/components/#group-ai'>AI components</wc-link>
          <wc-link href='/blocks/assistant/'>Assistant panel</wc-link>
          <wc-link href='/blocks/home-ai/'>Home with AI</wc-link>
        </div>
      </header>
      <div class='home-ai-demo' aria-label='A live example of the AI components'>
        <wc-ai-summary
          headline='For you today'
          hide-actions
          value={'- Your leave on 13 November is still waiting for Ada Lovelace.\n- INC-2318 is waiting for your reply.'}
        ></wc-ai-summary>
        <wc-card variant='outlined'>
          <wc-card-content class='home-ai-form'>
            <div class='text-title-medium'>New incident</div>
            <wc-input id='home-ai-field' label='Short description'></wc-input>
            <div class='home-demo-actions'>
              <wc-button variant='text'>Discard</wc-button>
              <wc-button level='primary'>Raise incident</wc-button>
            </div>
          </wc-card-content>
        </wc-card>
        <script is:inline>
          customElements.whenDefined('wc-input').then(function () {
            document.getElementById('home-ai-field').suggestion = {
              value: 'Cracked screen on laptop LT-0412',
              reason: 'From what you told the assistant',
            };
          });
        </script>
      </div>
    </section>

    <!-- Frameworks -->
    <section class='home-section home-split' aria-labelledby='frameworks'>
      <header class='home-section-header'>
        <h2 id='frameworks' class='text-headline-large'>Use it with your framework</h2>
        <p class='text-body-large home-muted'>
          The tags work anywhere HTML does. For React, Vue and Angular, the bindings packages add typed
          props and events, <code>v-model</code> and <code>ngModel</code>, and register each component for you.
          They are generated from the components, so they never fall behind.
        </p>
        <div class='home-links'>
          <wc-link href='/frameworks/react/'>React</wc-link>
          <wc-link href='/frameworks/vue/'>Vue</wc-link>
          <wc-link href='/frameworks/angular/'>Angular</wc-link>
        </div>
        <p class='text-body-small home-muted'>The bindings packages need Peacock 4.0 or later.</p>
      </header>
      <div class='home-code'>
        <wc-code-group>
          {frameworkExamples.map(tab => (
            <wc-code-highlighter label={tab.label} language={tab.language} value={tab.value} format='false'></wc-code-highlighter>
          ))}
        </wc-code-group>
      </div>
    </section>

    <!-- Theming -->
    <section class='home-section home-split home-theme' aria-labelledby='theming'>
      <header class='home-section-header'>
        <h2 id='theming' class='text-headline-large'>Make it yours</h2>
        <p class='text-body-large home-muted'>
          One source color sets the whole palette, in light and dark. Shape, fonts and contrast are a
          setting each. Build a theme in the <wc-link href='/theme-builder'>theme builder</wc-link>, or apply
          one at runtime with <code>applyTheme()</code>. The <wc-link href='/foundations/'>Foundations</wc-link>
          pages list every token a theme sets.
        </p>
        <div class='home-actions'>
          <wc-link-button href='/theme-builder' level='primary' variant='tonal'>Open the theme builder</wc-link-button>
        </div>
      </header>
      <div class='home-swatches' aria-hidden='true'>
        {['primary', 'secondary', 'tertiary', 'error'].map(role => (
          <div class='home-swatch' style={`--swatch: var(--color-${role}); --on-swatch: var(--color-on-${role})`}>
            <span class='text-label-large'>{role}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Getting started -->
    <section class='home-section' aria-labelledby='getting-started'>
      <header class='home-section-header'>
        <h2 id='getting-started' class='text-headline-large heading-scrollable'>Getting started</h2>
        <p class='text-body-large home-muted'>
          Add the stylesheet and the loader script to your page, then use the tags in HTML, JSX or any
          template. The loader registers only the components the page uses.
        </p>
      </header>
      <ol class='home-steps'>
        <li>
          <span class='home-step-number text-title-medium'>1</span>
          <div>
            <div class='text-title-medium'>Load Peacock</div>
            <p class='text-body-medium home-muted'>From the CDN, or install <code>{NPM_PACKAGE}</code> with npm.</p>
          </div>
        </li>
        <li>
          <span class='home-step-number text-title-medium'>2</span>
          <div>
            <div class='text-title-medium'>Use the tags</div>
            <p class='text-body-medium home-muted'>Each component page has live demos and its full API.</p>
          </div>
        </li>
        <li>
          <span class='home-step-number text-title-medium'>3</span>
          <div>
            <div class='text-title-medium'>Theme it</div>
            <p class='text-body-medium home-muted'>Load a generated theme after <code>styles.css</code>, or call <code>applyTheme()</code>.</p>
          </div>
        </li>
      </ol>
      <div class='home-code'>
        <wc-code-group>
          {gettingStarted.map(tab => (
            <wc-code-highlighter label={tab.label} language={tab.language} value={tab.value} format='false'></wc-code-highlighter>
          ))}
        </wc-code-group>
      </div>
    </section>

  </div>

  <Footer />
</Layout>
