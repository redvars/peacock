---
import Layout from '../layouts/Base.astro';
---
<Layout>
  <style is:inline>
    .not-found {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--spacing-200);
      min-height: 100vh;
      padding: var(--spacing-400);
      text-align: center;
    }

    .not-found p {
      margin: 0;
      max-width: 28rem;
    }
  </style>
  <main class='not-found'>
    <wc-illustration name='not-found' size='lg'></wc-illustration>
    <h1 class='text-headline-medium'>Page not found</h1>
    <p class='text-body-large doc-muted'>The page you are looking for does not exist. Check the address, or go back to the home page.</p>
    <wc-link-button href='/' trailing-icon>
      Go to home page
      <wc-icon name='arrow_right_alt' slot='icon'></wc-icon>
    </wc-link-button>
  </main>
</Layout>
