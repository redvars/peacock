---
import Layout from '../../../layouts/WithBlocksSidebar.astro';
import '../../../styles/blocks/dashboard.scss';

interface Stat {
  label: string;
  value: string;
  trend: string;
  up: boolean;
}

interface Order {
  name: string;
  order: string;
  detail: string;
  status: string;
  color: 'green' | 'yellow' | 'red';
}

const stats: Stat[] = [
  { label: 'Total Revenue', value: '$84,250', trend: '+12.5% vs last month', up: true },
  { label: 'Active Users', value: '3,842', trend: '+5.2% vs last month', up: true },
  { label: 'New Orders', value: '1,290', trend: '-2.1% vs last month', up: false },
  { label: 'Conversion Rate', value: '4.7%', trend: '+0.8% vs last month', up: true },
];

const orders: Order[] = [
  { name: 'Alice Liu', order: '#4821', detail: '2 items · $128.00', status: 'Delivered', color: 'green' },
  { name: 'Marcus Reid', order: '#4820', detail: '1 item · $54.99', status: 'Processing', color: 'yellow' },
  { name: 'Sara Okoye', order: '#4819', detail: '3 items · $219.50', status: 'Cancelled', color: 'red' },
];
---

<Layout
  title='Dashboard'
  description='An admin dashboard assembled from Peacock components: sidebar navigation, a top bar with search, KPI stat cards, an area chart, a doughnut chart and recent orders.'
>
  <div class='block-demo block-demo-shell'>
    <aside class='block-demo-sidebar'>
      <div class='sidebar-brand'>
        <wc-icon name='widgets'></wc-icon>
        <span class='text-title-medium'>AdminApp</span>
      </div>
      <wc-sidebar-menu selected-item='dashboard'>
        <wc-sidebar-menu-item label='Dashboard' value='dashboard' href='#'></wc-sidebar-menu-item>
        <wc-sidebar-sub-menu label='Analytics' expanded>
          <wc-sidebar-menu-item label='Overview' value='analytics-overview' href='#'></wc-sidebar-menu-item>
          <wc-sidebar-menu-item label='Reports' value='analytics-reports' href='#'></wc-sidebar-menu-item>
        </wc-sidebar-sub-menu>
        <wc-sidebar-menu-item label='Users' value='users' href='#'></wc-sidebar-menu-item>
        <wc-sidebar-menu-item label='Orders' value='orders' href='#'></wc-sidebar-menu-item>
        <wc-sidebar-menu-item label='Products' value='products' href='#'></wc-sidebar-menu-item>
        <wc-sidebar-menu-item label='Settings' value='settings' href='#'></wc-sidebar-menu-item>
      </wc-sidebar-menu>
    </aside>

    <main class='block-demo-main'>
      <div class='block-demo-topbar'>
        <span class='text-title-large'>Dashboard</span>
        <wc-search class='topbar-search' placeholder='Search…' size='sm'></wc-search>
        <div class='topbar-actions'>
          <wc-icon-button variant='text' aria-label='Notifications'>
            <wc-icon name='notifications'></wc-icon>
          </wc-icon-button>
          <wc-avatar name='Jane Doe'></wc-avatar>
        </div>
      </div>

      <div class='block-demo-content'>
        <div class='stats-row'>
          {stats.map(stat => (
            <wc-card class='stat-card'>
              <wc-card-content class='stat-card-inner'>
                <div class='stat-label text-body-medium'>{stat.label}</div>
                <div class='text-headline-medium'>{stat.value}</div>
                <div class={stat.up ? 'stat-trend up' : 'stat-trend down'}>
                  <wc-icon name={stat.up ? 'trending_up' : 'trending_down'}></wc-icon>
                  <span class='text-label-medium'>{stat.trend}</span>
                </div>
              </wc-card-content>
            </wc-card>
          ))}
        </div>

        <div class='charts-row'>
          <wc-card class='chart-card'>
            <wc-card-content class='chart-card-inner'>
              <h2 class='text-title-medium chart-title'>Monthly Revenue</h2>
              <wc-chart-area id='dashboard-revenue-chart' index='month' height='240' label='Monthly revenue'></wc-chart-area>
            </wc-card-content>
          </wc-card>
          <wc-card class='chart-card'>
            <wc-card-content class='chart-card-inner'>
              <h2 class='text-title-medium chart-title'>Traffic by Channel</h2>
              <wc-chart-doughnut id='dashboard-doughnut-chart' height='240' center-label='Visits' label='Traffic by channel'></wc-chart-doughnut>
            </wc-card-content>
          </wc-card>
        </div>

        <wc-card class='activity-card'>
          <wc-card-content class='activity-card-inner'>
            <h2 class='text-title-medium activity-title'>Recent Orders</h2>
            <div class='activity-list'>
              {orders.map(order => (
                <div class='activity-item'>
                  <wc-avatar name={order.name}></wc-avatar>
                  <div class='activity-text'>
                    <div class='text-body-medium'>{order.name}, order {order.order}</div>
                    <div class='text-body-small block-muted'>{order.detail}</div>
                  </div>
                  <wc-tag color={order.color}>{order.status}</wc-tag>
                </div>
              ))}
            </div>
          </wc-card-content>
        </wc-card>
      </div>
    </main>
  </div>

  <script is:inline>
    const revenueChart = document.getElementById('dashboard-revenue-chart');
    const currency = new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      notation: 'compact',
    });
    revenueChart.valueFormatter = value => currency.format(value);
    revenueChart.config = { revenue: { label: 'Revenue' } };
    revenueChart.data = [
      { month: 'Jan', revenue: 52000 },
      { month: 'Feb', revenue: 61000 },
      { month: 'Mar', revenue: 58000 },
      { month: 'Apr', revenue: 74000 },
      { month: 'May', revenue: 69000 },
      { month: 'Jun', revenue: 84250 },
    ];

    const doughnutChart = document.getElementById('dashboard-doughnut-chart');
    doughnutChart.data = [
      { name: 'organic', label: 'Organic', value: 42 },
      { name: 'direct', label: 'Direct', value: 28 },
      { name: 'social', label: 'Social', value: 18 },
      { name: 'referral', label: 'Referral', value: 12 },
    ];
  </script>
</Layout>
