---
import Layout from '../../../layouts/WithBlocksSidebar.astro';
import '../../../styles/blocks/auth.scss';
---

<Layout
  title='Login'
  description='A centered sign-in form built from Peacock components: email and password inputs, a remember-me checkbox, and primary and secondary sign-in actions.'
>
  <div class='block-demo block-demo-centered'>
    <wc-card class='auth-card'>
      <wc-card-content class='auth-card-inner'>
        <div class='auth-brand'>
          <wc-icon name='lock'></wc-icon>
          <h2 class='text-headline-small'>Sign in</h2>
          <p class='text-body-medium block-muted'>Welcome back. Enter your credentials to continue.</p>
        </div>

        <div class='auth-fields'>
          <wc-input type='email' label='Email address' placeholder='you@example.com' required></wc-input>
          <wc-input type='password' label='Password' placeholder='Enter your password' required></wc-input>
        </div>

        <div class='auth-options'>
          <wc-checkbox label='Remember me'></wc-checkbox>
          <wc-link href='#'>Forgot password?</wc-link>
        </div>

        <div class='auth-actions'>
          <wc-button level='primary' block>Sign in</wc-button>
          <wc-button variant='outlined' block>Continue with Google</wc-button>
        </div>

        <p class='text-body-medium auth-footer'>
          Don't have an account? <wc-link href='/blocks/signup/'>Create one</wc-link>
        </p>
      </wc-card-content>
    </wc-card>
  </div>
</Layout>
