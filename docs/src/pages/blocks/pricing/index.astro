---
import Layout from '../../../layouts/WithBlocksSidebar.astro';
import '../../../styles/blocks/pricing.scss';

interface Plan {
  id: string;
  name: string;
  description: string;
  monthly: number;
  yearly: number;
  unit: string;
  cta: string;
  featured: boolean;
  intro: string;
  features: string[];
}

interface Question {
  question: string;
  answer: string;
}

const plans: Plan[] = [
  {
    id: 'starter',
    name: 'Starter',
    description: 'For small teams getting organized.',
    monthly: 0,
    yearly: 0,
    unit: 'free for up to 5 members',
    cta: 'Start for free',
    featured: false,
    intro: 'Includes:',
    features: ['Unlimited projects and tasks', 'List, board and calendar views', '1 GB of file storage', 'Community support'],
  },
  {
    id: 'team',
    name: 'Team',
    description: 'For growing teams that ship together.',
    monthly: 12,
    yearly: 10,
    unit: 'per member / month',
    cta: 'Start 14-day trial',
    featured: true,
    intro: 'Everything in Starter, plus:',
    features: ['Roadmaps and timelines', 'Automations and recurring tasks', 'Guests and shared workspaces', '100 GB of file storage', 'Priority email support'],
  },
  {
    id: 'business',
    name: 'Business',
    description: 'For organizations with security needs.',
    monthly: 24,
    yearly: 19,
    unit: 'per member / month',
    cta: 'Talk to sales',
    featured: false,
    intro: 'Everything in Team, plus:',
    features: ['SAML single sign-on and SCIM', 'Audit log and data retention', 'Advanced permissions', 'Unlimited file storage', 'Dedicated success manager'],
  },
];

const questions: Question[] = [
  {
    question: 'Can I switch plans later?',
    answer: 'Yes. Upgrades take effect right away and we prorate the difference. Downgrades apply at the end of your current billing period.',
  },
  {
    question: 'How does the trial work?',
    answer: 'The Team plan is free for 14 days with every feature included. We ask for a card only when you decide to keep it, and your data stays if you move back to Starter.',
  },
  {
    question: 'Who counts as a member?',
    answer: 'Anyone who can create or edit work in your workspace. Guests who only view and comment are free on Team and Business.',
  },
  {
    question: 'Are there nonprofit discounts?',
    answer: 'Registered nonprofits and accredited schools get 50% off Team and Business. Contact sales with proof of status to apply.',
  },
];

const price = (value: number): string => `$${value}`;
---

<Layout
  title='Pricing'
  description='A pricing page built from Peacock components: a monthly and yearly toggle, three plan cards with feature lists and a highlighted plan, and an FAQ accordion.'
>
  <div class='block-demo pricing-demo'>
    <header class='pricing-hero'>
      <span class='text-label-large pricing-eyebrow'>Pricing</span>
      <h2 class='text-display-small'>Plans that grow with your team</h2>
      <p class='text-body-large block-muted'>Start free, then pay only for the people who build with you. Every plan includes unlimited projects.</p>
      <div class='pricing-toggle'>
        <wc-segmented-button-group id='pricing-period' label='Billing period' value='monthly'>
          <wc-segmented-button value='monthly'>Monthly</wc-segmented-button>
          <wc-segmented-button value='yearly'>Yearly</wc-segmented-button>
        </wc-segmented-button-group>
        <wc-tag intent='success' size='sm'>Save up to 20% yearly</wc-tag>
      </div>
    </header>

    <div class='pricing-plans'>
      {plans.map(plan => (
        <wc-card class={plan.featured ? 'pricing-plan featured' : 'pricing-plan'} variant={plan.featured ? 'elevated' : 'outlined'}>
          <wc-card-content class='pricing-plan-inner'>
            <div class='pricing-plan-head'>
              <h3 class='text-title-large'>{plan.name}</h3>
              {plan.featured && <wc-tag variant='filled' intent='info' size='sm'>Most popular</wc-tag>}
            </div>
            <p class='text-body-medium block-muted pricing-plan-description'>{plan.description}</p>
            <div class='pricing-price'>
              <span class='text-display-small pricing-amount' data-monthly={price(plan.monthly)} data-yearly={price(plan.yearly)}>
                {price(plan.monthly)}
              </span>
              <span class='text-body-small block-muted'>{plan.unit}</span>
            </div>
            <span
              class='text-body-small pricing-billed block-muted'
              data-monthly={plan.monthly === 0 ? 'No card required' : 'Billed monthly'}
              data-yearly={plan.yearly === 0 ? 'No card required' : `Billed yearly at $${plan.yearly * 12} per member`}
            >
              {plan.monthly === 0 ? 'No card required' : 'Billed monthly'}
            </span>
            <wc-button block level={plan.featured ? 'primary' : undefined} variant={plan.featured ? undefined : 'outlined'}>
              {plan.cta}
            </wc-button>
            <wc-divider></wc-divider>
            <p class='text-label-large pricing-intro'>{plan.intro}</p>
            <ul class='pricing-features'>
              {plan.features.map(feature => (
                <li class='text-body-medium'>
                  <wc-icon name='check_circle'></wc-icon>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </wc-card-content>
        </wc-card>
      ))}
    </div>

    <section class='pricing-faq'>
      <div class='pricing-faq-intro'>
        <h2 class='text-headline-small'>Frequently asked questions</h2>
        <p class='text-body-medium block-muted'>
          Still have questions? <wc-link href='#'>Talk to our team</wc-link>
        </p>
      </div>
      <wc-accordion class='pricing-faq-list'>
        {questions.map((item, index) => (
          <wc-accordion-item {...(index === 0 ? { open: true } : {})}>
            <span slot='heading'>{item.question}</span>
            <p class='text-body-medium block-muted'>{item.answer}</p>
          </wc-accordion-item>
        ))}
      </wc-accordion>
    </section>
  </div>

  <script is:inline>
    (() => {
      const period = document.getElementById('pricing-period');
      const swap = value => {
        const key = value === 'yearly' ? 'yearly' : 'monthly';
        document.querySelectorAll('.pricing-amount, .pricing-billed').forEach(el => {
          el.textContent = el.dataset[key];
        });
      };
      period.addEventListener('change', event => swap(event.detail.value));
    })();
  </script>
</Layout>
