---
import Layout from '../../layouts/WithChartsSidebar.astro';
import DemoComponentCard from '../../components/DemoComponentCard.astro';
import Highlighter from '../../components/Highlighter.astro';
import '../../styles/layout/doc-page.scss';
import '../../styles/pages/charts.scss';

const title = 'Theming charts';
const description =
  'Charts color their series from eight palette tokens that follow the theme. Override one series, one chart or the whole palette without touching component code.';

const palette = [
  { token: '--color-chart-1', light: 'primary 40', dark: 'primary 80' },
  { token: '--color-chart-2', light: 'tertiary 50', dark: 'tertiary 70' },
  { token: '--color-chart-3', light: 'blue 50', dark: 'blue 70' },
  { token: '--color-chart-4', light: 'green 50', dark: 'green 70' },
  { token: '--color-chart-5', light: 'orange 50', dark: 'orange 70' },
  { token: '--color-chart-6', light: 'purple 50', dark: 'purple 70' },
  { token: '--color-chart-7', light: 'red 50', dark: 'red 70' },
  { token: '--color-chart-8', light: 'yellow 50', dark: 'yellow 70' },
];

const paletteOverride = `/* Brand palette for every chart in the app */
:root {
  --color-chart-1: var(--color-primary);
  --color-chart-2: var(--color-blue-60);
}

/* Muted grid and axes in one dashboard */
.dashboard wc-chart-bar {
  --chart-grid-color: var(--color-surface-container-highest);
  --chart-axis-color: var(--color-outline);
}`;

const properties = [
  { name: '--color-chart-1 … 8', use: 'Series and slice colors, in order.' },
  { name: '--chart-grid-color', use: 'Gridlines and the zero line. Defaults to --color-outline-variant.' },
  { name: '--chart-axis-color', use: 'Axis labels. Defaults to --color-on-surface-variant.' },
  { name: '--chart-dim-opacity', use: 'Opacity of marks that are not hovered. Defaults to 0.4.' },
  { name: '--chart-cursor-color', use: 'The hover band or line. Defaults to --color-on-surface.' },
  { name: '--chart-line-width', use: 'Line and area stroke width. Defaults to 2px.' },
];
---

<Layout title={title} description={description}>
  <article class='doc-page charts-page'>
    <header class='doc-header'>
      <a class='text-label-large doc-eyebrow' href='/charts/'>Charts</a>
      <h1 class='text-display-small'>{title}</h1>
      <p class='text-body-large doc-muted'>{description}</p>
    </header>

    <section class='doc-section' aria-labelledby='palette-title'>
      <h2 class='text-headline-small' id='palette-title'>The chart palette</h2>
      <p class='text-body-large'>
        Series take the tokens in order and wrap after the eighth. The first two follow the theme's primary and
        tertiary colors; the rest are fixed accent hues picked to stay distinct from each other. Dark mode moves
        every token to a lighter tone so marks keep their contrast. The swatches below use the current theme.
      </p>
      <ul class='chart-palette'>
        {palette.map(item => (
          <li class='chart-swatch'>
            <span style={`background: var(${item.token})`}></span>
            <code class='text-label-medium'>{item.token}</code>
          </li>
        ))}
      </ul>
      <table class='chart-token-table text-body-medium'>
        <thead>
          <tr><th>Token</th><th>Light</th><th>Dark</th></tr>
        </thead>
        <tbody>
          {palette.map(item => (
            <tr><td><code>{item.token}</code></td><td>{item.light}</td><td>{item.dark}</td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class='doc-section' aria-labelledby='series-title'>
      <h2 class='text-headline-small' id='series-title'>Color one series</h2>
      <p class='text-body-large'>
        Give a series a <code>color</code> in <code>config</code>, or a slice a <code>color</code> in its data.
        Any CSS color works; a token keeps it theme-aware. Use it to tie a series to its meaning, such as errors
        in red.
      </p>
      <DemoComponentCard lang='html'>
        <wc-chart-bar id='theming-series' stacked index='day' height='240' label='Requests by status'></wc-chart-bar>

        <script is:inline>
          const themingSeries = document.getElementById('theming-series');
          themingSeries.config = {
            ok: { label: 'Success', color: 'var(--color-success)' },
            failed: { label: 'Failed', color: 'var(--color-error)' },
          };
          themingSeries.data = [
            { day: 'Mon', ok: 940, failed: 32 },
            { day: 'Tue', ok: 1020, failed: 18 },
            { day: 'Wed', ok: 880, failed: 75 },
            { day: 'Thu', ok: 1110, failed: 24 },
          ];
        </script>
      </DemoComponentCard>
    </section>

    <section class='doc-section' aria-labelledby='override-title'>
      <h2 class='text-headline-small' id='override-title'>Restyle charts with CSS</h2>
      <p class='text-body-large'>
        Redefine the palette tokens on <code>:root</code> for the whole app, or on a container for one area. The
        chart custom properties tune the grid, axes, hover and lines.
      </p>
      <Highlighter lang='css'><Fragment set:text={paletteOverride} /></Highlighter>
      <table class='chart-token-table text-body-medium'>
        <thead>
          <tr><th>Custom property</th><th>What it styles</th></tr>
        </thead>
        <tbody>
          {properties.map(item => (
            <tr><td><code>{item.name}</code></td><td>{item.use}</td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class='doc-section' aria-labelledby='frame-title'>
      <h2 class='text-headline-small' id='frame-title'>Framing a chart</h2>
      <p class='text-body-large'>
        Charts draw no background or border, so they sit in whatever surface holds them. Put a chart in a
        <a href='/components/card/'><code>wc-card</code></a> with a title for a dashboard tile.
      </p>
      <DemoComponentCard lang='html'>
        <wc-card variant='outlined' style='width: 100%; max-width: 28rem'>
          <wc-card-content>
            <h3 class='text-title-medium' style='margin: 0 0 var(--spacing-200)'>Weekly active users</h3>
            <wc-chart-area id='theming-card' index='week' height='180' hide-legend label='Weekly active users'></wc-chart-area>
          </wc-card-content>
        </wc-card>

        <script is:inline>
          const themingCard = document.getElementById('theming-card');
          themingCard.config = { users: { label: 'Users' } };
          themingCard.data = [
            { week: 'W1', users: 1200 },
            { week: 'W2', users: 1350 },
            { week: 'W3', users: 1290 },
            { week: 'W4', users: 1610 },
            { week: 'W5', users: 1740 },
            { week: 'W6', users: 1980 },
          ];
        </script>
      </DemoComponentCard>
    </section>
  </article>
</Layout>
