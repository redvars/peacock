---
export const title = 'Centre content and hole size';
export const order = 200;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  Put anything in the <code>center</code> slot to replace the total, such as a goal or a status.
  <code>inner-radius</code> sets the hole as a fraction of the radius, up to <code>0.9</code>; the default is
  <code>0.62</code>. The doughnut owns the hole: at <code>0</code> there is no hole, so the centre content and
  <code>center-label</code> are not shown. Use <code>wc-chart-pie</code> for a chart without a hole.
</p>

<DemoComponentCard lang='html'>
  <wc-chart-doughnut
    id='doughnut-center'
    inner-radius='0.75'
    legend='hide'
    height='220'
    label='Monthly goal progress'
  >
    <div slot='center' style='text-align: center'>
      <div class='text-headline-medium'>72%</div>
      <div class='text-label-medium'>of goal</div>
    </div>
  </wc-chart-doughnut>

  <script is:inline>
    document.getElementById('doughnut-center').data = [
      { name: 'done', label: 'Done', value: 72 },
      { name: 'left', label: 'Remaining', value: 28, color: 'var(--color-surface-container-highest)' },
    ];
  </script>
</DemoComponentCard>
