---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  A line chart takes the same <code>data</code>, <code>index</code> and <code>config</code> as the bar chart.
  Use it for trends over an ordered axis such as time. Hovering shows a cursor line and a dot on every series.
</p>

<DemoComponentCard lang='html'>
  <wc-chart-line id='line-usage' index='month' label='Visitors by month'></wc-chart-line>

  <script is:inline>
    const lineUsage = document.getElementById('line-usage');
    lineUsage.config = {
      desktop: { label: 'Desktop' },
      mobile: { label: 'Mobile' },
    };
    lineUsage.data = [
      { month: 'Jan', desktop: 186, mobile: 80 },
      { month: 'Feb', desktop: 305, mobile: 200 },
      { month: 'Mar', desktop: 237, mobile: 120 },
      { month: 'Apr', desktop: 73, mobile: 190 },
      { month: 'May', desktop: 209, mobile: 130 },
      { month: 'Jun', desktop: 214, mobile: 140 },
    ];
  </script>
</DemoComponentCard>
