---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<p>
  A tag is a read-only label for a status or a value. Use <code>intent</code> when the tag means
  something: <code>info</code>, <code>success</code>, <code>warning</code> or <code>danger</code>.
</p>

<DemoComponentCard lang={'html'}>
  <wc-tag>Draft</wc-tag>
  <wc-tag intent='info'>In review</wc-tag>
  <wc-tag intent='success'>
    <wc-icon name='check' slot='icon'></wc-icon>
    Approved
  </wc-tag>
  <wc-tag intent='warning'>Expiring</wc-tag>
  <wc-tag intent='danger'>Failed</wc-tag>
</DemoComponentCard>

<p>
  <code>accent</code> gives a decorative hue to tags without meaning, such as categories:
  <code>blue</code>, <code>green</code>, <code>red</code>, <code>yellow</code>, <code>orange</code>,
  <code>purple</code>. <code>intent</code> wins when both are set.
</p>

<DemoComponentCard lang={'html'}>
  <wc-tag accent='blue'>Frontend</wc-tag>
  <wc-tag accent='purple'>Design</wc-tag>
  <wc-tag accent='orange'>Docs</wc-tag>
</DemoComponentCard>
