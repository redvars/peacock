---
export const title = 'Variants';
export const order = 200;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<p><code>variant</code> sets the visual style: <code>tonal</code> (default), <code>filled</code>, <code>elevated</code> or <code>outlined</code>.</p>

<DemoComponentCard lang={'html'}>
  <wc-tag variant='filled' intent='info'><wc-icon name='home' slot='icon'></wc-icon> Filled</wc-tag>
  <wc-tag variant='tonal' intent='info'><wc-icon name='home' slot='icon'></wc-icon> Tonal</wc-tag>
  <wc-tag variant='elevated' intent='info'><wc-icon name='home' slot='icon'></wc-icon> Elevated</wc-tag>
  <wc-tag variant='outlined' intent='info'><wc-icon name='home' slot='icon'></wc-icon> Outlined</wc-tag>
</DemoComponentCard>
