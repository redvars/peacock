---
export const title = 'Events';
export const order = 400;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<p>
  The input dispatches <code>input</code> as the user types and <code>change</code> when the value is
  committed. Both are <b>CustomEvent</b>s with the value in <code>event.detail.value</code>.
</p>

<DemoComponentCard lang={'html'}>
  <wc-input variant='default' id='name-input-field' placeholder='Type here'></wc-input>

  <script is:inline>
    document.querySelector('#name-input-field').addEventListener('input', function(event) {
      myConsole.log('input :: ' + event.target.value);
    });
    document.querySelector('#name-input-field').addEventListener('change', function(event) {
      myConsole.warn('change :: ' + event.target.value);
    });
  </script>
</DemoComponentCard>
