---
export const title = 'Placements';
export const order = 200;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p class='text-body-medium'>
  The popover can be positioned relative to the trigger element. <code>placement</code> takes a side,
  <code>top</code>, <code>bottom</code> (default), <code>start</code> or <code>end</code>, optionally followed by
  an alignment, <code>-start</code> or <code>-end</code>. <code>start</code> and <code>end</code> follow the
  writing direction, so in right-to-left pages they flip.
  floating-ui automatically flips or shifts the panel to keep it visible inside the viewport.
  Add <code>arrow</code> to show an arrow that points at the trigger.
</p>

<style is:inline>
  .demo-placements-container .demo-area {
    min-height: 16rem !important;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>

<DemoComponentCard lang='html' cssClasses='demo-placements-container'>
  <wc-popover trigger='click' placement='top' arrow>
    <wc-button variant='outlined'>top</wc-button>
    <wc-popover-content>Placed on top</wc-popover-content>
  </wc-popover>
  <wc-popover trigger='click' placement='bottom' arrow>
    <wc-button variant='outlined'>bottom</wc-button>
    <wc-popover-content>Placed on bottom</wc-popover-content>
  </wc-popover>
  <wc-popover trigger='click' placement='start' arrow>
    <wc-button variant='outlined'>start</wc-button>
    <wc-popover-content>Placed at the start</wc-popover-content>
  </wc-popover>
  <wc-popover trigger='click' placement='end' arrow>
    <wc-button variant='outlined'>end</wc-button>
    <wc-popover-content>Placed at the end</wc-popover-content>
  </wc-popover>
</DemoComponentCard>

<h3>Deprecated</h3>
<ul>
  <li>
    <code>placement="left" | "right"</code> (and their <code>-start</code> / <code>-end</code> forms): use
    <code>start</code> and <code>end</code>.
  </li>
</ul>
