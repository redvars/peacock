---
export const title = 'Icons';
export const order = 300;
import HighlighterCard from '../../../../components/HighlighterCard.astro';
---
<p>Put an icon in the <code>icon</code> slot and a badge in the <code>badge</code> slot. An icon-only tab needs an <code>aria-label</code>.</p>

<HighlighterCard lang={'html'}>
<wc-tabs aria-label='Contact'>
  <wc-tab aria-label='Home'><wc-icon slot='icon' name='home'></wc-icon></wc-tab>
  <wc-tab selected>Circle <wc-icon slot='icon' name='circle'></wc-icon></wc-tab>
  <wc-tab disabled>Email <wc-icon slot='icon' name='mail'></wc-icon></wc-tab>
  <wc-tab>Starred <wc-icon slot='icon' name='star'></wc-icon><wc-badge slot='badge' value='3'></wc-badge></wc-tab>
</wc-tabs>
</HighlighterCard>
