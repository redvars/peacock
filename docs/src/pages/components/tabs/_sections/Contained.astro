---
export const title = 'Contained';
export const order = 200;
import HighlighterCard from '../../../../components/HighlighterCard.astro';
---
<p>The contained variant draws the tabs as segments inside an outlined container.</p>

<HighlighterCard lang={'html'}  cssClasses='demo-canvas'>
<wc-tab-group>
  <wc-tabs variant='contained' aria-label='Example'>
    <wc-tab>First tab</wc-tab>
    <wc-tab selected>Second tab</wc-tab>
    <wc-tab disabled>Disabled tab</wc-tab>
    <wc-tab>Last tab</wc-tab>
  </wc-tabs>

  <wc-tab-panel class='layer-01'>
    <p class='text-title-large'>First content</p>
  </wc-tab-panel>

  <wc-tab-panel class='layer-01'>
    <p class='text-title-large'>Second content</p>
  </wc-tab-panel>

  <wc-tab-panel class='layer-01'>
    <p class='text-title-large'>Disabled</p>
  </wc-tab-panel>

  <wc-tab-panel class='layer-01'>
    <p class='text-title-large'>Last content</p>
  </wc-tab-panel>
</wc-tab-group>
</HighlighterCard>
