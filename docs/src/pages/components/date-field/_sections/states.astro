---
export const title = 'Variants and states';
export const order = 400;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  The field takes the same <code>variant</code>, helper, error and warning options as the other
  fields. It is form-associated: inside a <code>&lt;form&gt;</code> it submits its ISO value under
  its <code>name</code>, and <code>form.reset()</code> restores its first value.
</p>

<DemoComponentCard lang={'html'}>
  <div style='width: 100%; max-width: 320px; display: flex; flex-direction: column; gap: 1rem;'>
    <wc-date-field label='Outlined' variant='outlined' value='2026-11-06'></wc-date-field>
    <wc-date-field label='Filled' variant='filled' value='2026-11-06'></wc-date-field>
    <wc-date-field label='Error' error error-text='Pick a later date' value='2026-11-06'></wc-date-field>
    <wc-date-field label='Disabled' disabled value='2026-11-06'></wc-date-field>
    <wc-date-field label='Read only' readonly value='2026-11-06'></wc-date-field>
  </div>
</DemoComponentCard>
