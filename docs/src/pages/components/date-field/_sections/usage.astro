---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  <code>wc-date-field</code> is a text field for a date. Type a date, or open the calendar
  (<code>wc-date-picker</code>) from the button or with Alt + Arrow Down. Escape closes the calendar
  and returns focus to the text.
</p>

<DemoComponentCard lang={'html'}>
  <div style='width: 100%; max-width: 320px; display: flex; flex-direction: column; gap: 1rem;'>
    <wc-date-field id='date-field-demo' label='Start date' value='2026-11-06' helper-text='The first day of the project'></wc-date-field>
    <wc-date-field label='Due date' show-actions></wc-date-field>
  </div>
  <script is:inline>
    document.querySelector('#date-field-demo').addEventListener('change', function (event) {
      myConsole.log('change :: ' + event.detail.value);
    });
  </script>
</DemoComponentCard>

<p>
  The text follows the locale (<code>locale</code>, or the page's language), and the placeholder
  shows its format, such as <code>MM/DD/YYYY</code>. The value is always ISO
  (<code>2026-11-06</code>).
</p>
