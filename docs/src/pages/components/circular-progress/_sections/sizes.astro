---
export const title = 'Sizes';
export const order = 300;
import HighlighterCard from '../../../../components/HighlighterCard.astro';
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<p>Set <code>--progress-height</code> (and <code>--progress-line-thickness</code>) to resize the indicator.</p>

<DemoComponentCard lang={'html'}>
  <wc-circular-progress style='--progress-height: 10rem' indeterminate></wc-circular-progress>
  <wc-circular-progress style='--progress-height: 5rem; --progress-line-thickness: 20px' indeterminate></wc-circular-progress>
</DemoComponentCard>
