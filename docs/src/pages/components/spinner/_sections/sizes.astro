---
export const title = 'Sizes';
export const order = 200;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<p class='text-body-emphasized'>
  The spinner's <code>--spinner-size</code>, <code>--spinner-track-color</code> and
  <code>--spinner-shape-color</code> still work. On <code>wc-circular-progress</code> they are
  <code>--progress-height</code>, <code>--progress-track-color</code> and
  <code>--progress-container-color</code>.
</p>

<DemoComponentCard lang={'html'}>
  <wc-circular-progress indeterminate class='progress-custom'></wc-circular-progress>

  <style is:inline>
    .progress-custom {
      --progress-height: 2rem;
      --progress-track-color: var(--color-success-container);
      --progress-container-color: var(--color-success);
    }
  </style>
</DemoComponentCard>
