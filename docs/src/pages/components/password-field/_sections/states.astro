---
export const title = 'Variants and states';
export const order = 400;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  The field takes the same <code>variant</code>, <code>size</code>, helper, error, warning and
  <code>clearable</code> options as the other fields. It is form-associated: inside a
  <code>&lt;form&gt;</code> it submits its value under its <code>name</code>, and
  <code>form.reset()</code> restores its first value.
</p>

<DemoComponentCard lang={'html'}>
  <div style='width: 100%; max-width: 320px; display: flex; flex-direction: column; gap: 1rem;'>
    <wc-password-field label='Outlined' variant='outlined' value='correct horse'></wc-password-field>
    <wc-password-field label='Filled' variant='filled' value='correct horse'></wc-password-field>
    <wc-password-field label='Clearable' clearable value='correct horse'></wc-password-field>
    <wc-password-field label='Error' error error-text='Wrong password' value='battery staple'></wc-password-field>
    <wc-password-field label='Disabled' disabled value='correct horse'></wc-password-field>
    <wc-password-field label='Read only' readonly value='correct horse'></wc-password-field>
  </div>
</DemoComponentCard>
