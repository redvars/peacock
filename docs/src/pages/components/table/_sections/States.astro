---
export const title = 'Loading and empty states';
export const order = 400;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';

import dataSource from '../_data-source.json';
---

<p>
  Set <code>loading</code> while data is on its way. Before the first rows arrive, the table shows
  skeleton rows in the shape of the columns. When rows are already shown, a thin progress bar runs
  under the header instead, so the current page stays readable while the next one loads.
</p>
<p>
  With no rows and no loading, the empty state appears. Set its text with
  <code>empty-state-headline</code> and <code>empty-state-description</code>.
</p>

<DemoComponentCard lang='html'>
  <wc-button id='reload-button' variant='tonal'>Reload</wc-button>
  <wc-button id='refresh-button' variant='outlined'>Refresh in place</wc-button>
  <wc-button id='clear-button' variant='text'>Clear data</wc-button>

  <div style='width: 100%; height: 24rem;'>
    <wc-table
      id='table-states'
      key-field='_id'
      label='People'
      empty-state-headline='No people yet'
      empty-state-description='People you add will appear here.'
    ></wc-table>
  </div>

  <script is:inline define:vars={{ dataSource }}>
    const $table = document.getElementById('table-states');
    const rows = dataSource.slice(0, 6);
    $table.columns = [
      { name: 'name', label: 'Name', width: 14 },
      { name: 'company', label: 'Company', width: 12 },
      { name: 'age', label: 'Age', width: 6, type: 'number' },
    ];
    $table.data = rows;

    function load(keepRows) {
      if (!keepRows) $table.data = [];
      $table.loading = true;
      setTimeout(() => {
        $table.data = rows;
        $table.loading = false;
      }, 1800);
    }
    document.getElementById('reload-button').addEventListener('click', () => load(false));
    document.getElementById('refresh-button').addEventListener('click', () => load(true));
    document.getElementById('clear-button').addEventListener('click', () => {
      $table.loading = false;
      $table.data = [];
    });
  </script>
</DemoComponentCard>
