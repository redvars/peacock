---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<p>
  Anchor a menu to a button with <code>anchor</code> and toggle <code>open</code>. The menu opens in the
  browser's top layer and moves focus to the selected item, or the first one. A selected item shows a
  check mark (give it <code>type="checkbox"</code> or <code>type="radio"</code> so the state is announced,
  see Choices), an item with a <code>wc-sub-menu</code> shows a chevron, and a disabled item is dimmed and
  skipped by the keyboard.
</p>
<DemoComponentCard lang={'html'}>
  <wc-button id='menu-anchor' variant='filled'>Open menu</wc-button>

  <wc-menu id='usage-menu' anchor='menu-anchor' aria-label='Account'>
    <wc-menu-item value='profile'>
      <wc-icon name='person' slot='start'></wc-icon>
      Profile
    </wc-menu-item>
    <wc-menu-item value='account'>
      <wc-icon name='settings' slot='start'></wc-icon>
      Account settings
    </wc-menu-item>
    <wc-menu-item value='notifications' type='checkbox' selected>Notifications</wc-menu-item>
    <wc-divider></wc-divider>
    <wc-sub-menu>
      <wc-menu-item slot='item' value='appearance'>
        <wc-icon name='palette' slot='start'></wc-icon>
        Appearance
      </wc-menu-item>
      <wc-menu slot='menu' aria-label='Appearance'>
        <wc-menu-item value='theme-light' type='radio'>Light</wc-menu-item>
        <wc-menu-item value='theme-dark' type='radio'>Dark</wc-menu-item>
        <wc-menu-item value='theme-system' type='radio' selected>System</wc-menu-item>
      </wc-menu>
    </wc-sub-menu>
    <wc-menu-item disabled>Billing (disabled)</wc-menu-item>
    <wc-menu-item value='logout'>
      <wc-icon name='logout' slot='start'></wc-icon>
      Log out
      <span slot='trailing-supporting-text'>Ctrl Q</span>
    </wc-menu-item>
  </wc-menu>

  <script is:inline>
    (() => {
      const menu = document.querySelector('#usage-menu');
      const anchor = document.querySelector('#menu-anchor');
      if (!menu || !anchor) return;

      anchor.addEventListener('click', () => {
        menu.open = !menu.open;
      });
      anchor.addEventListener('keydown', event => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          menu.show('first');
        }
      });
    })();
  </script>
</DemoComponentCard>
