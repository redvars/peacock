---
export const title = 'Slots';
export const order = 300;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<p>
  A menu item has a <code>start</code> slot for an icon or avatar, <code>trailing-supporting-text</code>
  for a shortcut, <code>end</code> for trailing content, and <code>supporting-text</code> for a second line.
  Items without a start icon line up with the ones that have one.
</p>
<DemoComponentCard lang={'html'}>
  <div style='display: flex; flex-wrap: wrap; gap: 2rem; align-items: flex-start;'>
    <wc-menu preview aria-label='Edit'>
      <wc-menu-item value='cut'>
        <wc-icon name='content_cut' slot='start'></wc-icon>
        Cut
        <span slot='trailing-supporting-text'>Ctrl X</span>
      </wc-menu-item>
      <wc-menu-item value='copy'>
        <wc-icon name='content_copy' slot='start'></wc-icon>
        Copy
        <span slot='trailing-supporting-text'>Ctrl C</span>
      </wc-menu-item>
      <wc-menu-item value='paste'>
        Paste
        <span slot='trailing-supporting-text'>Ctrl V</span>
      </wc-menu-item>
      <wc-divider></wc-divider>
      <wc-menu-item value='delete'>
        <wc-icon name='delete' slot='start'></wc-icon>
        Delete
        <span slot='trailing-supporting-text'>Del</span>
      </wc-menu-item>
    </wc-menu>

    <wc-menu preview aria-label='Assignee' style='--menu-width: 18rem'>
      <wc-menu-item value='ada' selected>
        <wc-avatar name='Ada Lovelace' slot='start'></wc-avatar>
        Ada Lovelace
        <span slot='supporting-text'>Software engineer</span>
      </wc-menu-item>
      <wc-menu-item value='grace'>
        <wc-avatar name='Grace Hopper' slot='start'></wc-avatar>
        Grace Hopper
        <span slot='supporting-text'>Manager</span>
      </wc-menu-item>
      <wc-menu-item value='alan'>
        <wc-avatar name='Alan Turing' slot='start'></wc-avatar>
        Alan Turing
        <span slot='supporting-text'>Researcher</span>
      </wc-menu-item>
    </wc-menu>
  </div>
</DemoComponentCard>
