---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  Use <code>wc-navigation-rail</code> for a compact vertical set of primary
  destinations. Items stay top-aligned. Mark the page the user is on with
  <code>current</code> (it sets <code>aria-current="page"</code>); clicking an
  item makes it current and the rail fires <code>change</code> with
  <code>{'{ value, index, item }'}</code>, like <code>wc-navigation-bar</code>
  and <code>wc-navigation-drawer</code>. Items take a <code>badge</code>,
  <code>href</code>, <code>disabled</code> and <code>disabled-reason</code>.
</p>

<DemoComponentCard lang={'html'}>
  <wc-navigation-rail id="navigation-rail-demo" aria-label="Primary" style="height: 400px; border: 1px solid var(--color-outline-variant); border-radius: 1rem; overflow: hidden;">
    <wc-navigation-rail-item value="home" current>
      <wc-icon slot="icon" name="home"></wc-icon>
      Home
    </wc-navigation-rail-item>
    <wc-navigation-rail-item value="search">
      <wc-icon slot="icon" name="search"></wc-icon>
      Search
    </wc-navigation-rail-item>
    <wc-navigation-rail-item value="saved">
      <wc-icon slot="icon" name="bookmark"></wc-icon>
      Saved
    </wc-navigation-rail-item>
    <wc-navigation-rail-item value="inbox" badge="3">
      <wc-icon slot="icon" name="inbox"></wc-icon>
      Inbox
    </wc-navigation-rail-item>
    <wc-navigation-rail-item value="settings">
      <wc-icon slot="icon" name="settings"></wc-icon>
      Settings
    </wc-navigation-rail-item>
  </wc-navigation-rail>
  <script is:inline>
    document.querySelector('#navigation-rail-demo').addEventListener('change', function (event) {
      myConsole.log('Navigated to :: ' + event.detail.value);
    });
  </script>
</DemoComponentCard>
