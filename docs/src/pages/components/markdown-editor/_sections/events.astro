---
export const title = 'Events';
export const order = 300;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro'
---

<p>
  The editor fires <code>input</code> while the Markdown content changes and
  <code>change</code> when focus leaves the editor with a different value, like
  a native field. Both are <code>CustomEvent</code>s with the Markdown in
  <code>detail.value</code>. <code>input</code> is debounced (default 250 ms,
  configurable via the <code>debounce</code> property) to avoid excessive calls
  while the user is typing.
</p>

<DemoComponentCard lang={'html'}>
  <wc-markdown-editor
    id="md-events-demo"
    label="Editor"
    helper-text="Edit content to see input and change events in the console."
    style="display:block;"
  ></wc-markdown-editor>
  <script is:inline>
    const el = document.getElementById('md-events-demo');

    el.value = '## Hello\n\nStart typing to fire `input` events.';

    el.addEventListener('input', event => {
      console.log('input fired — value:', event.detail.value);
    });
    el.addEventListener('change', event => {
      console.log('change fired — value:', event.detail.value);
    });
  </script>
</DemoComponentCard>

<h3>Custom debounce</h3>

<p>
  Set <code>debounce="0"</code> for immediate <code>input</code> events or a
  higher value (e.g. <code>debounce="1000"</code>) to reduce frequency on slow
  connections.
</p>

<DemoComponentCard lang={'html'}>
  <wc-markdown-editor
    id="md-events-debounce"
    label="Editor (500 ms debounce)"
    debounce="500"
    helper-text="Input events fire 500 ms after you stop typing."
    style="display:block;"
  ></wc-markdown-editor>
  <script is:inline>
    const debounced = document.getElementById('md-events-debounce');
    debounced.value = 'Type here…';
    debounced.addEventListener('input', event => {
      console.log('debounced input:', event.detail.value);
    });
  </script>
</DemoComponentCard>
