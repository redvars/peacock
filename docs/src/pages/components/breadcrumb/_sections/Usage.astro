---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<p>
  <code>wc-breadcrumb</code> is a navigation landmark holding an ordered list; each
  <code>wc-breadcrumb-item</code> is one of its list items (<code>role="listitem"</code> on the
  element itself, because the list lives in the breadcrumb's shadow root). Mark the page the user
  is on with <code>current</code>: it renders as text with <code>aria-current="page"</code>.
</p>

<DemoComponentCard lang={"html"}>
  <wc-breadcrumb>
    <wc-breadcrumb-item href="/">Home</wc-breadcrumb-item>
    <wc-breadcrumb-item href="/components">Components</wc-breadcrumb-item>
    <wc-breadcrumb-item current>Page</wc-breadcrumb-item>
  </wc-breadcrumb>
</DemoComponentCard>

