---
export const title = 'Layout and states';
export const order = 400;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  <code>orientation="horizontal"</code> lays the checkboxes out in a row.
  <code>disabled</code> and <code>readonly</code> pass to every checkbox; turning them off again
  leaves a checkbox that was disabled on its own alone. <code>error</code> with
  <code>error-text</code> shows an error, and a failed check shows the validation message.
</p>

<DemoComponentCard lang={'html'}>
  <div style='display: flex; flex-direction: column; gap: 1.5rem;'>
    <wc-checkbox-group label='Horizontal' orientation='horizontal' value='a'>
      <wc-checkbox value='a' label='One'></wc-checkbox>
      <wc-checkbox value='b' label='Two'></wc-checkbox>
      <wc-checkbox value='c' label='Three'></wc-checkbox>
    </wc-checkbox-group>
    <wc-checkbox-group label='Required' required error error-text='Pick at least one'>
      <wc-checkbox value='a' label='One'></wc-checkbox>
      <wc-checkbox value='b' label='Two'></wc-checkbox>
    </wc-checkbox-group>
    <wc-checkbox-group label='Disabled' disabled value='a'>
      <wc-checkbox value='a' label='One'></wc-checkbox>
      <wc-checkbox value='b' label='Two'></wc-checkbox>
    </wc-checkbox-group>
    <wc-checkbox-group label='Read only' readonly value='b'>
      <wc-checkbox value='a' label='One'></wc-checkbox>
      <wc-checkbox value='b' label='Two'></wc-checkbox>
    </wc-checkbox-group>
  </div>
</DemoComponentCard>
