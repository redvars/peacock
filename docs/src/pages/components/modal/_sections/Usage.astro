---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<style is:inline>
  /* Shared by every modal demo on this page. */
  .modal-demo-text {
    margin: 0 0 var(--spacing-200);
  }

  .modal-demo-text:last-child {
    margin-bottom: 0;
  }

  .modal-demo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-100);
    justify-content: flex-end;
    padding: var(--spacing-200) var(--spacing-300);
  }

  .modal-demo-actions .modal-demo-spacer {
    flex: 1 1 auto;
  }

  .modal-demo-form {
    display: grid;
    gap: var(--spacing-200);
  }

  .modal-demo-form > * {
    display: block;
    width: 100%;
  }
</style>

<p>
  Put the message in the default slot and the actions in the <code>footer</code> slot. Call
  <code>show()</code> and <code>hide()</code>, or set the <code>open</code> attribute. The modal
  fires <code>open</code> when it opens and <code>close</code> when it closes, with
  <code>detail.reason</code>: <code>'action'</code> (the close button), <code>'light-dismiss'</code>
  (a scrim click), <code>'escape'</code>, or <code>'api'</code> (<code>hide()</code>).
</p>
<p>
  Set <code>no-light-dismiss</code> to keep the modal open on scrim clicks (Escape still closes
  it), and <code>loading</code> to cover the content with a progress indicator while it works.
</p>
<p>
  A confirmation asks one question and names the action on its button. Keep it short: say what
  will happen and whether it can be undone.
</p>

<DemoComponentCard lang={'html'}>
  <wc-button level='danger' data-open-modal='delete-project-modal'>Delete project</wc-button>

  <wc-modal id='delete-project-modal' heading='Delete “Atlas Website”?' size='sm'>
    <p class='modal-demo-text text-body-medium'>
      The project, its 14 pages and 3 environments are deleted for everyone on the team. This
      can’t be undone.
    </p>

    <div slot='footer' class='modal-demo-actions'>
      <wc-button variant='text' data-close-modal>Cancel</wc-button>
      <wc-button level='danger' data-close-modal>Delete project</wc-button>
    </div>
  </wc-modal>

  <script is:inline>
    // Any element with data-open-modal="<id>" opens that modal; data-close-modal closes the
    // modal it sits in. Every demo on this page uses these two attributes.
    if (!window.__modalDemoWired) {
      window.__modalDemoWired = true;
      document.addEventListener('click', event => {
        const opener = event.target.closest?.('[data-open-modal]');
        if (opener) {
          document.getElementById(opener.dataset.openModal)?.show();
          return;
        }
        const closer = event.target.closest?.('[data-close-modal]');
        if (closer) closer.closest('wc-modal')?.hide();
      });
    }
  </script>
</DemoComponentCard>
