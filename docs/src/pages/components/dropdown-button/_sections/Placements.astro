---
export const title = 'Placements';
export const order = 600;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  <code>placement</code> sets where the menu opens relative to the button: a side, <code>top</code>,
  <code>bottom</code>, <code>start</code> or <code>end</code>, optionally followed by <code>-start</code> or
  <code>-end</code>. It defaults to <code>bottom-start</code>. <code>start</code> and <code>end</code> follow
  the writing direction, so <code>end-start</code> opens to the right in left-to-right pages and to the left
  in right-to-left pages. The menu flips to stay in the viewport.
</p>

<DemoComponentCard lang={'html'} inline>
  <wc-dropdown-button placement='bottom-start'>
    Bottom Start
    <wc-menu-item slot="menu">Option A</wc-menu-item>
    <wc-menu-item slot="menu">Option B</wc-menu-item>
  </wc-dropdown-button>

  <wc-dropdown-button placement='bottom-end'>
    Bottom End
    <wc-menu-item slot="menu">Option A</wc-menu-item>
    <wc-menu-item slot="menu">Option B</wc-menu-item>
  </wc-dropdown-button>

  <wc-dropdown-button placement='top-start'>
    Top Start
    <wc-menu-item slot="menu">Option A</wc-menu-item>
    <wc-menu-item slot="menu">Option B</wc-menu-item>
  </wc-dropdown-button>

  <wc-dropdown-button placement='top-end'>
    Top End
    <wc-menu-item slot="menu">Option A</wc-menu-item>
    <wc-menu-item slot="menu">Option B</wc-menu-item>
  </wc-dropdown-button>

  <wc-dropdown-button placement='end-start'>
    End Start
    <wc-menu-item slot="menu">Option A</wc-menu-item>
    <wc-menu-item slot="menu">Option B</wc-menu-item>
  </wc-dropdown-button>
</DemoComponentCard>
