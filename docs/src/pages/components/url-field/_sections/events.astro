---
export const title = 'Events';
export const order = 300;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>URL Field emits <code>input</code> with <code>{'{ value }'}</code> as the user types and <code>change</code> when the value is committed. Check <code>validity</code> or call <code>checkValidity()</code> to know whether the URL is valid.</p>

<DemoComponentCard lang={'html'}>
  <wc-url-field
    id='url-field-events-demo'
    label='Project URL'
    placeholder='https://example.com'
  ></wc-url-field>

  <script is:inline>
    const urlField = document.querySelector('#url-field-events-demo');

    urlField.addEventListener('input', function(event) {
      myConsole.log('input :: ' + event.detail.value);
    });

    urlField.addEventListener('change', function(event) {
      myConsole.log('change :: ' + event.detail.value);
      if (!urlField.checkValidity()) myConsole.warn('invalid URL');
    });
  </script>
</DemoComponentCard>
