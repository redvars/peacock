---
export const title = 'Week View';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  <code>date</code> sets the date the view shows as an ISO string (<code>YYYY-MM-DD</code>); the
  <code>contextDate</code> property holds the same date as a <code>Date</code>, and the two stay in step.
  <code>date-change</code> carries both, as <code>detail.date</code> and <code>detail.value</code>.
  <code>first-day</code> sets the first day of the week, <code>0</code> (Sunday) to <code>6</code>; it defaults
  to the locale's week start. <code>today()</code>, <code>previous()</code> and <code>next()</code> move the
  view. <code>timezone</code> takes an IANA zone such as <code>America/New_York</code> for the current-time line
  and Today.
</p>

<p>
  <code>loading</code> shows a progress bar and marks the calendar busy while you fetch events.
  <code>events-readonly</code> shows events without making them clickable or focusable; otherwise each event is
  a button that fires <code>event-click</code> on click, Enter or Space. The month view is a grid of weeks and
  days; day and week views are a region labelled with their dates.
</p>

<DemoComponentCard lang={'html'}>
  <wc-calendar id='week-calendar' view='week' style='height: 700px; width: 100%'></wc-calendar>
  <script is:inline>
    (function() {
      const $calendar = document.getElementById('week-calendar');

      const today = new Date();
      today.setHours(0, 0, 0, 0);

      function addDays(date, days) {
        var result = new Date(date);
        result.setDate(result.getDate() + days);
        return result;
      }

      function addHours(date, hours) {
        var result = new Date(date);
        result.setHours(result.getHours() + hours);
        return result;
      }

      $calendar.events = [
        {
          start: addHours(today, 9),
          end: addHours(today, 11),
          title: 'Team Standup',
        },
        {
          start: addHours(today, 10),
          end: addHours(today, 12),
          title: 'Design Review',
          color: 'red'
        },
        {
          start: addHours(today, 14),
          end: addHours(today, 15),
          title: 'Sprint Planning',
          color: 'green'
        },
        {
          start: addHours(addDays(today, 1), 8),
          end: addHours(addDays(today, 1), 10),
          title: 'Code Review',
        },
        {
          start: addHours(addDays(today, 1), 13),
          end: addHours(addDays(today, 1), 16),
          title: 'Workshop',
          color: 'orange'
        },
        {
          start: addHours(addDays(today, -1), 10),
          end: addHours(addDays(today, -1), 11),
          title: 'Retrospective',
        },
        {
          start: addDays(today, -1),
          end: addDays(today, 2),
          title: 'Conference (multi-day)',
          color: 'blue'
        },
      ];

      $calendar.addEventListener('event-click', function(evt) {
        console.log('Event clicked:', evt.detail);
      });
    })();
  </script>
</DemoComponentCard>
