---
export const title = 'Usage';
export const order = 100;
import HighlighterCard from '../../../../components/HighlighterCard.astro';
import Highlighter from '../../../../components/Highlighter.astro';
---
<p>
  <strong>Deprecated.</strong> <code>wc-sidebar-menu</code>, <code>wc-sidebar-sub-menu</code> and
  <code>wc-sidebar-menu-item</code> are replaced by <a href='/components/navigation-drawer'>
  <code>wc-navigation-drawer</code></a> with <code>wc-navigation-drawer-group</code> and
  <code>wc-navigation-drawer-item</code>. They keep working until 4.0 and log a console warning
  once per page.
</p>
<p>
  The menu is now a navigation landmark of buttons and links rather than a <code>tree</code>, and
  the selected item has <code>aria-current="page"</code>. It fires <code>change</code> with
  <code>{'{ value, item }'}</code>; the older <code>sidebar-menu:change</code> still fires.
</p>

<HighlighterCard lang={'html'}>
  <wc-sidebar-menu id='sidebar-menu' style='width: 300px;' selected-item='Blockchain'>
    <wc-sidebar-menu-item label='Artificial intelligence'></wc-sidebar-menu-item>
    <wc-sidebar-menu-item label='Blockchain'></wc-sidebar-menu-item>
    <wc-sidebar-sub-menu label='Cloud computing' expanded>
      <wc-sidebar-menu-item label='Containers'></wc-sidebar-menu-item>
      <wc-sidebar-menu-item label='Databases'></wc-sidebar-menu-item>
    </wc-sidebar-sub-menu>
  </wc-sidebar-menu>
</HighlighterCard>

<h3>Migrating</h3>
<p>
  Labels and icons move from attributes into slots: an item's label is its content, a group's
  label goes in <code>slot="label"</code>. <code>selected-item</code> becomes
  <code>current</code> on the item, and <code>expanded</code> stays on the group.
</p>

<Highlighter lang='html' is:raw>
  <wc-navigation-drawer open>
    <wc-navigation-drawer-item value="ai">Artificial intelligence</wc-navigation-drawer-item>
    <wc-navigation-drawer-item value="blockchain" current>Blockchain</wc-navigation-drawer-item>
    <wc-navigation-drawer-group expanded>
      <span slot="label">Cloud computing</span>
      <wc-navigation-drawer-item value="containers">Containers</wc-navigation-drawer-item>
      <wc-navigation-drawer-item value="databases">Databases</wc-navigation-drawer-item>
    </wc-navigation-drawer-group>
  </wc-navigation-drawer>
</Highlighter>

<script is:inline>
  const sidebarMenu = document.querySelector('#sidebar-menu');
  sidebarMenu.addEventListener('change', function(evt) {
    myConsole.log(JSON.stringify(evt.detail.value, null, 4),  evt.type);
  });
</script>
