---
export const title = 'Events';
export const order = 600;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<p>
  The checkbox dispatches a <code>change</code> <b>CustomEvent</b> when it is toggled.
  <code>event.detail</code> holds <code>checked</code>, the checkbox's <code>value</code> and the
  <code>originalEvent</code> that caused the toggle.
</p>

<DemoComponentCard lang={'html'}>
  <wc-checkbox id='change-checkbox-field'>Change Event?</wc-checkbox>

  <script is:inline>
    document.querySelector('#change-checkbox-field').addEventListener('change', function(event) {
      myConsole.log('change :: checked = ' + event.detail.checked);
    });
  </script>
</DemoComponentCard>
