---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro'
---

<wc-checkbox id="disableEditor">Disable editor</wc-checkbox>
<wc-checkbox id="readonlyEditor">Read-only editor</wc-checkbox>

<DemoComponentCard lang={'html'}>
  <wc-html-editor
    id="html-editor"
    label="Message"
    helper-text="Use Visual mode for formatting and HTML mode for source edits"
    style="display:block;"
  ></wc-html-editor>
  <script is:inline>
    const editor = document.getElementById('html-editor');

    editor.value = `<p>Hi everyone! <strong>Don't forget the daily stand-up at 8 AM.</strong></p>
<p>Please review the tasks assigned to you before the meeting.</p>
<p>Ping @Alex if you need help.</p>`;

    editor.mentions = [
      { label: 'Alex', value: 'alex' },
      { label: 'Pat', value: 'pat' },
      { label: 'Jordan', value: 'jordan' },
    ];

    document.querySelector('#disableEditor').addEventListener('change', function (evt) {
      editor.disabled = evt.target.value;
    });

    document.querySelector('#readonlyEditor').addEventListener('change', function (evt) {
      editor.readonly = evt.target.value;
    });

    // `input` fires while editing; `change` when focus leaves with a different value.
    editor.addEventListener('input', event => {
      console.log('html-editor input:', event.detail.value);
    });
    editor.addEventListener('change', event => {
      console.log('html-editor change:', event.detail.value);
    });
  </script>
</DemoComponentCard>

<p>
  The editor includes a segmented switch for <strong>Visual</strong> and
  <strong>HTML</strong> modes. Both modes stay in sync through the <code>value</code> property.
</p>

<DemoComponentCard lang={'html'}>
  <wc-html-editor
    id="html-editor-managed"
    label="Managed Mentions"
    mentions-search="managed"
    placeholder="Type @ to search managed mentions"
    style="display:block;"
  ></wc-html-editor>
  <script is:inline>
    const managedEditor = document.getElementById('html-editor-managed');

    // Answer each `mention-search` by setting `mentions` (now or later, e.g. after a fetch).
    managedEditor.addEventListener('mention-search', event => {
      const query = (event.detail?.query || '').toLowerCase();
      const directory = [
        { label: 'Alex Morgan', value: 'alex.morgan' },
        { label: 'Alicia Torres', value: 'alicia.torres' },
        { label: 'Jordan Lee', value: 'jordan.lee' },
        { label: 'Pat Kim', value: 'pat.kim' },
      ];

      managedEditor.mentions = directory.filter(item =>
        item.label.toLowerCase().includes(query),
      );
    });
  </script>
</DemoComponentCard>
