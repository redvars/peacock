---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  <code>wc-html-editor</code> is the same editor as
  <code>wc-markdown-editor</code>, for fields whose value has to be HTML, such
  as an email body. It has the same toolbar, selection bubble, slash menu,
  block handle, link editor and mentions. HTML can store underline and
  resizable table columns, so the HTML editor offers them; <strong>View
  source</strong> shows the HTML.
</p>
<p>
  Only what the editor supports is kept: other tags, attributes and scripts in
  a value are dropped when it loads.
</p>

<wc-checkbox id="disableEditor">Disable editor</wc-checkbox>
<wc-checkbox id="readonlyEditor">Read-only editor</wc-checkbox>

<DemoComponentCard lang={'html'}>
  <wc-html-editor
    id="html-editor"
    label="Message"
    helper-text="Format text, type @ to mention, or view the HTML source."
    style="display:block; width: 100%;"
  ></wc-html-editor>
  <script is:inline>
    const editor = document.getElementById('html-editor');

    editor.value = `<p>Hi everyone! <strong>Don't forget the daily stand-up at 8 AM.</strong></p>
<p>Please <u>review the tasks</u> assigned to you before the meeting.</p>`;

    const people = [
      { id: 'alex', label: 'Alex Morgan', description: 'Design' },
      { id: 'pat', label: 'Pat Kim', description: 'Engineering' },
      { id: 'jordan', label: 'Jordan Lee', description: 'Support' },
    ];
    // Answer each `search` by setting `suggestions`, now or after a request.
    editor.addEventListener('search', event => {
      const query = event.detail.query.toLowerCase();
      editor.suggestions = people.filter(person =>
        person.label.toLowerCase().includes(query),
      );
    });

    document.querySelector('#disableEditor').addEventListener('change', function (evt) {
      editor.disabled = evt.target.value;
    });

    document.querySelector('#readonlyEditor').addEventListener('change', function (evt) {
      editor.readonly = evt.target.value;
    });

    // `input` fires while editing; `change` when focus leaves with a different value.
    editor.addEventListener('input', event => {
      console.log('html-editor input:', event.detail.value);
    });
    editor.addEventListener('change', event => {
      console.log('html-editor change:', event.detail.value);
    });
  </script>
</DemoComponentCard>
