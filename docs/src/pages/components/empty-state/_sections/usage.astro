---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<style is:inline>
  #page-404 {
    height: 40rem;
    width: 100%;
  }
</style>
<p>
  The layout follows the width of the empty state itself (a container query), not the window: below
  672px the illustration stacks above the text, wider they sit side by side. So an empty state in a
  narrow panel stacks even on a wide screen.
</p>
<DemoComponentCard lang='html'>

  <wc-empty-state
    id='page-404'
    illustration="page"
    headline="404 : Page not found :("
    description="The page you are looking for does not exist. Please check the URL or go back to the homepage.">
    <div slot="actions">
      <wc-button href="/">Go to home page
        <wc-icon name="arrow_right_alt" slot='icon'></wc-icon>
      </wc-button>
    </div>
  </wc-empty-state>
</DemoComponentCard>
