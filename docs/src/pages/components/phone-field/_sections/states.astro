---
export const title = 'Variants and states';
export const order = 400;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  The field takes the same <code>variant</code>, <code>size</code>, helper, error, warning and
  <code>clearable</code> options as the other fields. It is form-associated: inside a
  <code>&lt;form&gt;</code> it submits the E.164 value under its <code>name</code>, and
  <code>form.reset()</code> restores its first value and country.
</p>

<DemoComponentCard lang={'html'}>
  <div style='width: 100%; max-width: 360px; display: flex; flex-direction: column; gap: 1rem;'>
    <wc-phone-field label='Outlined' variant='outlined' value='+14155550100'></wc-phone-field>
    <wc-phone-field label='Filled' variant='filled' value='+14155550100'></wc-phone-field>
    <wc-phone-field label='Clearable' clearable value='+14155550100'></wc-phone-field>
    <wc-phone-field label='Error' error error-text='This number is already in use' value='+14155550100'></wc-phone-field>
    <wc-phone-field label='Disabled' disabled value='+14155550100'></wc-phone-field>
    <wc-phone-field label='Read only' readonly value='+14155550100'></wc-phone-field>
  </div>
</DemoComponentCard>
