---
export const title = 'Placement';
export const order = 550;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  <code>placement</code> sets where the menu opens relative to the button: a side, <code>top</code>,
  <code>bottom</code>, <code>start</code> or <code>end</code>, optionally followed by <code>-start</code> or
  <code>-end</code>. It defaults to <code>bottom-end</code>, so the menu lines up with the arrow.
  <code>start</code> and <code>end</code> follow the writing direction. The physical sides <code>left</code>
  and <code>right</code> still work but are deprecated.
</p>

<DemoComponentCard lang={'html'} inline>
  <wc-split-button>
    Bottom End
    <wc-menu-item slot='menu'>Save as draft</wc-menu-item>
    <wc-menu-item slot='menu'>Save and publish</wc-menu-item>
  </wc-split-button>

  <wc-split-button placement='top-start'>
    Top Start
    <wc-menu-item slot='menu'>Save as draft</wc-menu-item>
    <wc-menu-item slot='menu'>Save and publish</wc-menu-item>
  </wc-split-button>
</DemoComponentCard>
