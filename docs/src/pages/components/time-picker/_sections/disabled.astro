---
export const title = 'Clock and limits';
export const order = 300;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  The clock follows the locale. <code>hour-cycle="h12"</code> or <code>"h23"</code> sets it.
  <code>min</code> and <code>max</code> disable entries outside the allowed times.
</p>

<DemoComponentCard lang={'html'}>
  <div style='display: flex; flex-wrap: wrap; gap: 2rem;'>
    <wc-time-picker value='09:00' hour-cycle='h23' min='08:00' max='17:30'></wc-time-picker>
    <wc-time-picker value='09:00' hour-cycle='h12'></wc-time-picker>
    <wc-time-picker value='09:00' disabled></wc-time-picker>
  </div>
</DemoComponentCard>
