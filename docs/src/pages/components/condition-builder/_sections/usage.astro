---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<style is:inline>
  .condition-builder-demo {
    width: 100%;
    max-width: 52rem;
  }
</style>

<p>
  Build a query from rules (<code>wc-cb-rule</code>) and bordered nested groups (<code>wc-cb-group</code>). Each group
  joins its items with a bracket: click the <strong>And</strong> / <strong>Or</strong> pill to switch it. Drag a rule by
  its handle to reorder it or move it into another group, and use the trash icon to remove it.
</p>

<DemoComponentCard lang={'html'}>
  <wc-condition-builder class='condition-builder-demo' operator='and'>

    <wc-cb-rule>
      <wc-select value='opportunity-id'>
        <wc-option value='opportunity-id'>Opportunity ID</wc-option>
        <wc-option value='expected-amount'>Expected amount</wc-option>
        <wc-option value='fiscal-year'>Fiscal year</wc-option>
      </wc-select>
      <wc-select value='eq'>
        <wc-option value='eq'>Is equal to</wc-option>
        <wc-option value='neq'>Does not equal</wc-option>
      </wc-select>
      <wc-input value='24902390229'></wc-input>
    </wc-cb-rule>

    <wc-cb-group operator='or'>
      <wc-cb-rule>
        <wc-select value='expected-amount'>
          <wc-option value='expected-amount'>Expected amount</wc-option>
          <wc-option value='fiscal-year'>Fiscal year</wc-option>
        </wc-select>
        <wc-select value='eq'>
          <wc-option value='eq'>Equals to</wc-option>
          <wc-option value='gt'>Is bigger than</wc-option>
        </wc-select>
        <wc-input value='175,000'></wc-input>
      </wc-cb-rule>
      <wc-cb-rule>
        <wc-select value='fiscal-year'>
          <wc-option value='expected-amount'>Expected amount</wc-option>
          <wc-option value='fiscal-year'>Fiscal year</wc-option>
        </wc-select>
        <wc-select value='gt'>
          <wc-option value='eq'>Equals to</wc-option>
          <wc-option value='gt'>Is bigger than</wc-option>
        </wc-select>
        <wc-input value='2024'></wc-input>
      </wc-cb-rule>
      <wc-cb-rule>
        <wc-select value='last-modified'>
          <wc-option value='last-modified'>Last modified date</wc-option>
          <wc-option value='created'>Created date</wc-option>
        </wc-select>
        <wc-select value='neq'>
          <wc-option value='eq'>Is on</wc-option>
          <wc-option value='neq'>Does not equal</wc-option>
        </wc-select>
        <wc-select value='today'>
          <wc-option value='today' icon='calendar_today'>Today</wc-option>
          <wc-option value='yesterday' icon='calendar_today'>Yesterday</wc-option>
        </wc-select>
      </wc-cb-rule>
    </wc-cb-group>

    <wc-button slot='actions-end'>Run Query</wc-button>
  </wc-condition-builder>
</DemoComponentCard>
