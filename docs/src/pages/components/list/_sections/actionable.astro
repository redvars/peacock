---
export const title = 'Actionable';
export const order = 200;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  Add <code>actionable</code>, or an <code>href</code>, to make a row
  interactive: it gets hover, press and focus states, and the list moves focus
  between actionable rows with the arrow keys, <kbd>Home</kbd> and
  <kbd>End</kbd>.
</p>

<DemoComponentCard lang={'html'}>
  <wc-list style='width: min(100%, 28rem);'>
    <wc-list-item actionable>
      <wc-icon slot='start' name='person'></wc-icon>
      Profile settings
      <wc-icon slot='end' name='chevron_right'></wc-icon>
    </wc-list-item>
    <wc-list-item href='//redvars.com' target='_blank'>
      <wc-avatar slot='start' name='Ada Lovelace'></wc-avatar>
      Ada Lovelace
      <span slot='supporting-text'>Software Engineer</span>
      <span slot='trailing-supporting-text'>7</span>
    </wc-list-item>
    <wc-list-item actionable disabled>
      <wc-icon slot='start' name='lock'></wc-icon>
      Security (Disabled)
    </wc-list-item>
  </wc-list>
</DemoComponentCard>
