---
export const title = 'Usage';
export const order = 100;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  <code>wc-list-item</code> has <code>start</code>, default and
  <code>end</code> slots, plus <code>overline</code>,
  <code>supporting-text</code> and <code>trailing-supporting-text</code>.
</p>

<DemoComponentCard lang={'html'}>
  <wc-list style='width: min(100%, 28rem);'>
    <wc-list-item>
      <wc-icon slot='start' name='inbox'></wc-icon>
      Inbox
      <span slot='trailing-supporting-text'>24</span>
    </wc-list-item>
    <wc-list-item>
      <wc-avatar slot='start' name='Ada Lovelace'></wc-avatar>
      Ada Lovelace
      <span slot='supporting-text'>Software Engineer</span>
      <span slot='trailing-supporting-text'>7</span>
    </wc-list-item>
    <wc-list-item>
      <wc-icon slot='start' name='send'></wc-icon>
      Sent
      <wc-icon slot='end' name='chevron_right'></wc-icon>
    </wc-list-item>

    <wc-divider></wc-divider>

    <h2
      class='text-title'
      style='padding-inline: var(--item-padding-inline, 1rem)'
    >
      Section title
    </h2>

    <wc-list-item disabled>
      <wc-icon slot='start' name='delete'></wc-icon>
      Trash (Disabled)
    </wc-list-item>
  </wc-list>
</DemoComponentCard>
