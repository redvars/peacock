---
export const title = 'Variants';
export const order = 200;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<p>
  <code>build</code> (the default) raises the stem and swings the arm out. <code>trace</code> draws the outline and fills it.
  <code>fill</code> fills the r from the baseline. <code>pulse</code> beats the tile and sends out a ring.
  <code>orbit</code> runs a line round a track outside the mark.
</p>

<DemoComponentCard lang={'html'}>
  <wc-brand-loader variant='build'></wc-brand-loader>
  <wc-brand-loader variant='trace'></wc-brand-loader>
  <wc-brand-loader variant='fill'></wc-brand-loader>
  <wc-brand-loader variant='pulse'></wc-brand-loader>
  <wc-brand-loader variant='orbit'></wc-brand-loader>
</DemoComponentCard>
