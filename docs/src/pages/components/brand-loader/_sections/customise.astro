---
export const title = 'Size and color';
export const order = 400;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---
<p>Set <code>--brand-loader-size</code>, the colors and the loop length on the element. The pulse variant loops at three quarters of <code>--brand-loader-duration</code>.</p>

<DemoComponentCard lang={'html'}>
  <wc-brand-loader class='brand-loader-small'></wc-brand-loader>
  <wc-brand-loader class='brand-loader-large'></wc-brand-loader>
  <wc-brand-loader class='brand-loader-inverse' variant='trace'></wc-brand-loader>

  <style is:inline>
    .brand-loader-small {
      --brand-loader-size: 2rem;
    }

    .brand-loader-large {
      --brand-loader-size: 6rem;
      --brand-loader-duration: 3.2s;
    }

    .brand-loader-inverse {
      --brand-loader-tile-color: #ffffff;
      --brand-loader-mark-color: #ff0000;
    }
  </style>
</DemoComponentCard>
