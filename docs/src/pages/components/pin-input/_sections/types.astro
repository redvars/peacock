---
export const title = 'Length, type and masking';
export const order = 200;
import DemoComponentCard from '../../../../components/DemoComponentCard.astro';
---

<p>
  <code>length</code> sets the number of cells (6 by default). <code>type="numeric"</code>, the
  default, takes digits and shows the numeric keypad on phones. <code>type="alphanumeric"</code>
  takes the letters A–Z and digits and uppercases letters, so the value is what the cells show.
  Other characters are ignored, so a pasted <code>123-456</code> or <code>G-123456</code> fills
  <code>123456</code>. <code>masked</code> hides the characters like a password, for PINs.
</p>

<DemoComponentCard lang={'html'}>
  <div style='display: flex; flex-direction: column; gap: 1rem;'>
    <wc-pin-input label='PIN' length='4' masked></wc-pin-input>
    <wc-pin-input label='Backup code' type='alphanumeric' length='8'></wc-pin-input>
  </div>
</DemoComponentCard>
