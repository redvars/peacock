---
import Layout from '../layouts/WithComponentsSidebar.astro';
import '../styles/layout/doc-page.scss';
import '../styles/components.page.scss';

import { getAllComponentsForShowcase } from '../_data/getLitComponentDetails.ts';
import WebComponentCard from '../components/WebComponentCard.astro';
const title = 'Components';
const description =
  'Every Peacock web component, grouped by what it does. Search by name, or open a component for live demos and its API reference.';
const componentEntries = getAllComponentsForShowcase();

// Groups follow what a component is for. A component missing from every group still shows,
// under "Others", so a new component is never hidden; add it to a group when you add it.
const componentGroups = [
  {
    name: 'Primitive',
    components: ['ripple', 'elevation', 'icon', 'focus-ring', 'divider', 'kbd'],
  },
  {
    name: 'Layout & App shell',
    components: [
      'app-shell',
      'app-bar',
      'page-header',
      'container',
      'stack',
      'grid',
      'card',
      'resizable-panels',
      'scroll-area',
    ],
  },
  {
    name: 'Buttons',
    components: [
      'button',
      'icon-button',
      'link-button',
      'fab',
      'button-group',
      'dropdown-button',
      'split-button',
      'segmented-button-group',
      'copy-button',
    ],
  },
  {
    name: 'Navigation',
    components: [
      'navigation-drawer',
      'navigation-rail',
      'navigation-bar',
      'breadcrumb',
      'pagination',
      'tabs',
      'stepper',
      'anchor-nav',
      'toolbar',
      'menu',
      'command-palette',
      'workspace-switcher',
      'user-menu',
    ],
  },
  {
    name: 'Text inputs',
    components: [
      'input',
      'password-field',
      'password-rules',
      'number-field',
      'currency-field',
      'phone-field',
      'url-field',
      'textarea',
      'mention-input',
      'pin-input',
      'search',
      'inline-edit',
    ],
  },
  {
    name: 'Selection',
    components: [
      'select',
      'listbox',
      'checkbox',
      'checkbox-group',
      'radio',
      'radio-group',
      'switch',
      'slider',
      'rating',
      'chip-set',
      'transfer-list',
      'tree',
    ],
  },
  {
    name: 'Date & Time',
    components: [
      'date-field',
      'date-range-field',
      'date-picker',
      'time-field',
      'time-picker',
      'datetime-field',
      'calendar',
      'clock',
      'relative-time',
    ],
  },
  {
    name: 'Forms',
    components: [
      'form',
      'fieldset',
      'file-upload',
      'signature-pad',
      'color-field',
      'color-picker',
      'condition-builder',
      'filter-bar',
    ],
  },
  {
    name: 'Data display',
    components: [
      'table',
      'list',
      'virtual-list',
      'description-list',
      'stat',
      'sparkline',
      'kanban',
      'timeline',
      'json-viewer',
      'diff-viewer',
      'code-highlighter',
      'number-counter',
    ],
  },
  {
    name: 'People & status',
    components: [
      'avatar',
      'avatar-group',
      'presence-indicator',
      'badge',
      'tag',
      'chip',
      'status-indicator',
      'comment-thread',
    ],
  },
  {
    name: 'Feedback',
    components: [
      'alert',
      'banner',
      'snackbar',
      'notification-manager',
      'notification-center',
      'illustration',
      'skeleton',
    ],
  },
  {
    name: 'Overlays',
    components: [
      'modal',
      'confirm-dialog',
      'side-sheet',
      'bottom-sheet',
      'popover',
      'tooltip',
      'hover-card',
      'tour',
    ],
  },
  {
    name: 'Loading & Progress',
    components: ['circular-progress', 'linear-progress', 'redvars-loader'],
  },
  {
    name: 'Editors',
    components: ['code-editor', 'html-editor', 'markdown-editor', 'flow'],
  },
];

const groupedTags = componentGroups.flatMap(g => g.components);
componentGroups.push(
  ...(() => {
    const othersArr = componentEntries.filter(
      c => !groupedTags.includes(c.rawTag),
    );
    return othersArr.length
      ? [
          {
            name: 'Others',
            components: othersArr.map(c => c.rawTag),
            entries: othersArr,
          },
        ]
      : [];
  })(),
);

const groupsWithEntries = componentGroups.map(g => ({
  ...g,
  entries:
    g.entries ?? componentEntries.filter(c => g.components.includes(c.rawTag)),
}));

const sortedComponents = [...componentEntries].sort((a, b) =>
  a.rawTag.localeCompare(b.rawTag),
);
---

<Layout
  title={title}
  description={description}
  classes="surface-container-lowest"
>
  <article class="doc-page components-page">
    <header class="doc-header">
      <h1 class="text-display-small">{title}</h1>
      <p class="text-body-large doc-muted">{description}</p>
      <p class="text-body-medium doc-muted">
        Looking for bar, line, area, pie or doughnut charts? They have their own
        <a href="/charts/">Charts</a> section.
      </p>
    </header>

    <div id="search-container">
      <wc-search id="component-search" layer="01" placeholder="Search"
      ></wc-search>
    </div>

    <div id="grouped-view" class="cards-holder">
      {
        groupsWithEntries.map(
          group =>
            group.entries.length > 0 && (
              <section class="component-group">
                <h2 class="text-headline-small group-title">{group.name}</h2>
                <div class="cards">
                  {group.entries.map(component => (
                    <WebComponentCard component={component} />
                  ))}
                </div>
              </section>
            ),
        )
      }
    </div>

    <div id="flat-view" class="cards-holder hidden">
      <div class="cards">
        {sortedComponents.map(component => (
          <WebComponentCard component={component} />
        ))}
      </div>
    </div>
  </article>

  <script is:inline>
    const $componentSearchElm = document.getElementById('component-search');
    customElements.whenDefined('wc-search').then(function () {
      $componentSearchElm.focus();
    });

    const $groupedView = document.getElementById('grouped-view');
    const $flatView = document.getElementById('flat-view');

    $componentSearchElm.addEventListener('input', function (e) {
      window.scrollTo({ top: 0, behavior: 'instant' });
      const query = e.target.value.toLowerCase();

      if (query) {
        $groupedView.classList.add('hidden');
        $flatView.classList.remove('hidden');
        $flatView.querySelectorAll('.component-card').forEach(elm => {
          elm.classList.toggle('hidden', elm.innerText.toLowerCase().indexOf(query) === -1);
        });
      } else {
        $flatView.classList.add('hidden');
        $groupedView.classList.remove('hidden');
      }
    });


    const $searchContainer = document.querySelector('#search-container');

    document.querySelector('.with-sidebar-layout-content').addEventListener('scroll', function (event) {
      const scrollPosition = event.target.scrollTop;

      if (scrollPosition > 0) {
        $searchContainer.classList.add('scrolled');
      } else {
        $searchContainer.classList.remove('scrolled');
      }
    });
  </script>
</Layout>
