---
import Layout from '../layouts/Default.astro';
import ThemePreview from '../components/theme-builder/ThemePreview.astro';
import { getThemeEngineUrl } from '../_data/utils.ts';
import '../styles/pages/theme-builder.scss';

const engineUrl = getThemeEngineUrl(import.meta.env.PROD);
const customColors = [
  { key: 'secondary', label: 'Secondary' },
  { key: 'tertiary', label: 'Tertiary' },
  { key: 'neutral', label: 'Neutral' },
];
---

<Layout
  title='Theme builder'
  description='Build a Peacock theme: pick color, contrast, shape and fonts, preview it live on fields, charts, tables, AI insights and diagrams, then copy the token CSS.'
  keywords='theme builder, material 3, design tokens, color scheme, css variables'
>
  <!-- The generated tokens, declared on .theme-preview only. -->
  <style is:inline id='theme-builder-style'></style>
  <link id='theme-builder-fonts' rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&display=swap' />

  <div class='theme-builder'>
    <header class='tb-header'>
      <h1 class='text-display-small'>Theme builder</h1>
      <p class='text-body-large tb-muted'>
        Pick your global theme settings, check them live on Peacock components, then copy the complete token CSS. The
        palettes come from Material 3 color science, so every role meets its contrast pairing. The
        <wc-link href='/foundations/'>Foundations</wc-link> pages explain each token, from
        <wc-link href='/foundations/color/'>color roles</wc-link> to <wc-link href='/foundations/shape/'>shape</wc-link>.
      </p>
    </header>

    <aside class='tb-controls' id='tb-controls' aria-labelledby='tb-controls-title'>
      <div class='tb-controls-header'>
        <h2 class='text-title-medium' id='tb-controls-title'>Theme settings</h2>
        <wc-icon-button id='reset-theme' variant='text' shape='round' tooltip='Reset to default' aria-label='Reset to default'>
          <wc-icon name='restart_alt'></wc-icon>
        </wc-icon-button>
      </div>

      <wc-tab-group class='tb-controls-body'>
        <wc-tabs aria-label='Theme settings' variant='secondary' class='tb-controls-tabs'>
          <wc-tab selected>Color</wc-tab>
          <wc-tab>Style</wc-tab>
        </wc-tabs>

        <wc-tab-panel>
          <div class='tb-panel'>
          <section class='tb-group' aria-labelledby='tb-primary-label'>
            <span class='text-label-large' id='tb-primary-label'>Primary</span>
            <wc-color-picker id='primary-picker' value='#7c5df0' aria-label='Primary color'></wc-color-picker>
          </section>

          <section class='tb-group' aria-labelledby='tb-accents-label' aria-describedby='tb-accents-note'>
            <span class='text-label-large' id='tb-accents-label'>Accents and neutral</span>
            <span class='text-body-small tb-muted' id='tb-accents-note'>Derived from primary unless you set your own.</span>
            {customColors.map(({ key, label }) => (
              <div class='tb-custom-color' data-key={key}>
                <div class='tb-custom-color-row'>
                  <span class='tb-swatch' data-swatch={key} aria-hidden='true'></span>
                  <wc-switch class='tb-custom-switch' data-key={key} label={`Custom ${label.toLowerCase()}`}></wc-switch>
                </div>
                <wc-color-field class='tb-custom-field' data-key={key} label={`${label} color`} hidden></wc-color-field>
              </div>
            ))}
          </section>
          </div>
        </wc-tab-panel>

        <wc-tab-panel>
          <div class='tb-panel'>
          <section class='tb-group' aria-labelledby='tb-scheme-label'>
            <span class='text-label-large' id='tb-scheme-label'>Scheme</span>
            <wc-select id='variant-select' label='Variant'></wc-select>
            <span class='text-body-small tb-muted' id='contrast-label'>Contrast</span>
            <div class='tb-choices' id='contrast-choices' role='group' aria-labelledby='contrast-label'></div>
          </section>

          <section class='tb-group' aria-labelledby='shape-label'>
            <span class='text-label-large' id='shape-label'>Corner shape</span>
            <div class='tb-choices' id='shape-choices' role='group' aria-labelledby='shape-label'></div>
          </section>

          <section class='tb-group' aria-labelledby='tb-type-label'>
            <span class='text-label-large' id='tb-type-label'>Typography</span>
            <wc-select id='brand-font-select' label='Brand font (display, headline, title)'></wc-select>
            <wc-select id='plain-font-select' label='Plain font (body, label)'></wc-select>
          </section>
          </div>
        </wc-tab-panel>
      </wc-tab-group>

      <div class='tb-controls-footer'>
        <wc-button id='download-css' variant='filled' size='sm'>
          <wc-icon slot='icon' name='download'></wc-icon>
          Download CSS
        </wc-button>
        <wc-button id='copy-link' variant='outlined' size='sm'>
          <wc-icon slot='icon' name='link'></wc-icon>
          Copy link
        </wc-button>
      </div>
    </aside>

    <main class='tb-main' aria-labelledby='tb-preview-title'>
      <div class='tb-toolbar'>
        <h2 class='text-title-large' id='tb-preview-title'>Preview</h2>
        <wc-segmented-button-group id='preview-mode' aria-label='Preview mode'>
          <wc-segmented-button value='light' icon='light_mode' selected>Light</wc-segmented-button>
          <wc-segmented-button value='dark' icon='dark_mode'>Dark</wc-segmented-button>
          <wc-segmented-button value='both' icon='splitscreen_right'>Both</wc-segmented-button>
        </wc-segmented-button-group>
      </div>

      <div class='tb-previews' data-mode='light'>
        <ThemePreview id='preview-light' mode='light' />
        <ThemePreview id='preview-dark' mode='dark' />
      </div>

      <section class='tb-code' aria-labelledby='tb-code-title'>
        <h2 class='text-title-large' id='tb-code-title'>Generated CSS</h2>
        <p class='text-body-medium tb-muted'>
          This is the complete token set for your theme: palettes, color roles for light and
          <code class='text-code-block'>[data-theme='dark']</code> (also used when the system is dark, unless the page
          sets <code class='text-code-block'>data-theme='light'</code>), shape, typography, spacing and motion. Load it after
          Peacock's <code class='text-code-block'>styles.css</code> to replace the default tokens. You can also apply a
          theme at runtime with <code class='text-code-block'>applyTheme(config)</code> from
          <code class='text-code-block'>@redvars/peacock/theme</code>.
        </p>
        <wc-code-editor id='theme-code' language='css' readonly></wc-code-editor>
      </section>
    </main>

    <!-- Phones: the settings sit above the preview; this brings them back. -->
    <wc-fab id='tb-jump' class='tb-jump' variant='filled' label='Theme settings' hidden>
      <wc-icon name='tune'></wc-icon>
    </wc-fab>
  </div>

  <script is:inline define:vars={{ engineUrl }}>
    (async () => {
      const STORAGE_KEY = 'peacock-theme-builder';
      const CUSTOM_KEYS = ['secondary', 'tertiary', 'neutral'];
      const $ = selector => document.querySelector(selector);
      const $$ = selector => [...document.querySelectorAll(selector)];

      const engine = await import(engineUrl);
      await Promise.all(
        ['wc-color-picker', 'wc-color-field', 'wc-select', 'wc-switch', 'wc-chip'].map(tag =>
          customElements.whenDefined(tag),
        ),
      );

      const previews = $$('.theme-preview');
      const styleEl = $('#theme-builder-style');
      const fontsLink = $('#theme-builder-fonts');
      const codeEditor = $('#theme-code');
      const primaryPicker = $('#primary-picker');
      const variantSelect = $('#variant-select');
      const brandSelect = $('#brand-font-select');
      const plainSelect = $('#plain-font-select');
      const contrastChoices = $('#contrast-choices');
      const shapeChoices = $('#shape-choices');

      let config = loadConfig();
      let theme;
      let buildId = 0;
      let rebuildTimer;

      // ── Config persistence: URL hash first (shareable), then localStorage.

      function loadConfig() {
        const params = new URLSearchParams(location.hash.slice(1));
        if (params.has('primary')) {
          return engine.normalizeThemeConfig({
            primary: params.get('primary'),
            secondary: params.get('secondary') || undefined,
            tertiary: params.get('tertiary') || undefined,
            neutral: params.get('neutral') || undefined,
            variant: params.get('variant'),
            contrast: params.get('contrast'),
            shape: params.get('shape'),
            font: { brand: params.get('brand'), plain: params.get('plain') },
          });
        }
        try {
          const stored = localStorage.getItem(STORAGE_KEY);
          if (stored) return engine.normalizeThemeConfig(JSON.parse(stored));
        } catch {
          // Storage can be unavailable (private mode, blocked site data).
        }
        return engine.normalizeThemeConfig(engine.defaultThemeConfig);
      }

      function saveConfig() {
        const params = new URLSearchParams();
        for (const key of ['primary', ...CUSTOM_KEYS, 'variant', 'contrast', 'shape']) {
          if (config[key]) params.set(key, config[key]);
        }
        params.set('brand', config.font.brand);
        params.set('plain', config.font.plain);
        history.replaceState(null, '', `#${params}`);
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
        } catch {
          // Ignore: the hash still holds the config.
        }
      }

      // ── Build

      async function rebuild() {
        const id = ++buildId;
        const next = await engine.createTheme(config);
        if (id !== buildId) return; // A newer change is already building.
        theme = next;

        styleEl.textContent = engine.scopeThemeCss(theme.css, '.theme-preview');
        previews.forEach(preview => preview.removeAttribute('style'));
        codeEditor.value = theme.css;
        if (theme.fontsUrl) fontsLink.href = theme.fontsUrl;
        updateSwatches();
        saveConfig();
      }

      function scheduleRebuild() {
        clearTimeout(rebuildTimer);
        rebuildTimer = setTimeout(rebuild, 200);
      }

      // Instant feedback while a color is dragged: set the palette tones on
      // the previews, whose role aliases then resolve to them. The full build
      // follows once the pointer settles.
      function previewPalettes() {
        const variables = engine.paletteVariables(config);
        previews.forEach(preview => {
          for (const [name, value] of Object.entries(variables)) preview.style.setProperty(name, value);
        });
      }

      function derivedColor(key) {
        const tone = key === 'neutral' ? 50 : 40;
        return theme.palettes[key].find(([t]) => t === tone)?.[1];
      }

      function updateSwatches() {
        for (const key of CUSTOM_KEYS) {
          $(`[data-swatch="${key}"]`).style.background = config[key] ?? derivedColor(key);
        }
      }

      // ── Controls

      // Single-choice chips; they wrap, so they fit the narrow settings panel.
      function choices(container, options, onSelect, icon) {
        container.replaceChildren(
          ...options.map(option => {
            const chip = document.createElement('wc-chip');
            chip.dataset.value = option.value;
            chip.textContent = option.label;
            if (icon) chip.prepend(icon(option));
            chip.addEventListener('click', () => onSelect(option.value));
            return chip;
          }),
        );
      }

      function selectChoice(container, value) {
        for (const chip of container.children) {
          chip.selected = chip.dataset.value === value;
          chip.setAttribute('aria-pressed', String(chip.selected));
        }
      }

      function cornerGlyph(preset) {
        const glyph = document.createElement('span');
        glyph.slot = 'icon';
        glyph.className = 'tb-corner';
        glyph.style.borderStartStartRadius = `${Math.min(preset.corners[2], 14)}px`;
        return glyph;
      }

      function showCustom(key, custom) {
        const field = $(`.tb-custom-field[data-key="${key}"]`);
        field.hidden = !custom;
        if (custom) field.value = config[key];
      }

      function syncControls() {
        primaryPicker.value = config.primary;
        variantSelect.value = config.variant;
        brandSelect.value = config.font.brand;
        plainSelect.value = config.font.plain;
        selectChoice(contrastChoices, config.contrast);
        selectChoice(shapeChoices, config.shape);
        for (const key of CUSTOM_KEYS) {
          // A switch's state is `checked`; its `value` is the string it submits in a form.
          $(`.tb-custom-switch[data-key="${key}"]`).checked = Boolean(config[key]);
          showCustom(key, Boolean(config[key]));
        }
      }

      const fontOptions = engine.FONT_OPTIONS.map(({ value, label }) => ({ value, label }));
      variantSelect.options = engine.VARIANTS;
      brandSelect.options = fontOptions;
      plainSelect.options = fontOptions;
      choices(contrastChoices, engine.CONTRAST_LEVELS, contrast => {
        config = engine.normalizeThemeConfig({ ...config, contrast });
        selectChoice(contrastChoices, contrast);
        scheduleRebuild();
      });
      choices(
        shapeChoices,
        engine.SHAPE_PRESETS,
        shape => {
          config = engine.normalizeThemeConfig({ ...config, shape });
          selectChoice(shapeChoices, shape);
          scheduleRebuild();
        },
        cornerGlyph,
      );

      primaryPicker.addEventListener('input', event => {
        if (!event.detail?.value) return;
        config = engine.normalizeThemeConfig({ ...config, primary: event.detail.value });
        previewPalettes();
        scheduleRebuild();
      });

      $$('.tb-custom-switch').forEach(toggle => {
        toggle.addEventListener('change', event => {
          if (event.target !== toggle) return;
          const key = toggle.dataset.key;
          const custom = Boolean(event.detail?.checked ?? toggle.checked);
          if (custom) {
            // Start the override from the color it replaces, so nothing jumps.
            config = { ...config, [key]: config[key] ?? derivedColor(key) ?? config.primary };
          } else {
            const { [key]: _removed, ...rest } = config;
            config = rest;
          }
          showCustom(key, custom);
          scheduleRebuild();
        });
      });

      $$('.tb-custom-field').forEach(field => {
        const update = event => {
          if (event.target !== field || !event.detail?.value) return;
          config = { ...config, [field.dataset.key]: event.detail.value };
          previewPalettes();
          scheduleRebuild();
        };
        field.addEventListener('input', update);
        field.addEventListener('change', update);
      });

      variantSelect.addEventListener('change', event => {
        if (event.target !== variantSelect) return;
        config = engine.normalizeThemeConfig({ ...config, variant: event.detail.value });
        scheduleRebuild();
      });

      for (const [select, slot] of [[brandSelect, 'brand'], [plainSelect, 'plain']]) {
        select.addEventListener('change', event => {
          if (event.target !== select) return;
          config = engine.normalizeThemeConfig({ ...config, font: { ...config.font, [slot]: event.detail.value } });
          scheduleRebuild();
        });
      }

      $('#preview-mode').addEventListener('change', event => {
        if (event.target.id !== 'preview-mode' || !event.detail.value) return;
        $('.tb-previews').dataset.mode = event.detail.value;
        // Diagrams laid out while hidden go back to their start view at their new size.
        requestAnimationFrame(() => $$('.theme-preview .preview-diagram').forEach(diagram => diagram.home?.()));
      });

      // Phones: once the settings scroll out of view, a button brings them back.
      const controls = $('#tb-controls');
      const jump = $('#tb-jump');
      jump.addEventListener('click', () => controls.scrollIntoView({ behavior: 'smooth', block: 'start' }));
      new IntersectionObserver(([entry]) => {
        jump.hidden = entry.isIntersecting || entry.boundingClientRect.top > 0;
      }).observe(controls);

      // ── Actions

      function notify(title, intent = 'success') {
        window.dispatchEvent(new CustomEvent('peacock-toast', { detail: { target: 'global', title, intent } }));
      }

      // The async Clipboard API can be blocked (permissions, embedded
      // browsers); fall back to a selected textarea.
      async function copyText(text, label) {
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const area = Object.assign(document.createElement('textarea'), { value: text });
          area.style.cssText = 'position: fixed; opacity: 0;';
          document.body.append(area);
          area.select();
          const copied = document.execCommand('copy');
          area.remove();
          if (!copied) {
            notify(`Couldn't copy the ${label}. Select it and copy it by hand.`, 'warning');
            return;
          }
        }
        notify(`${label.charAt(0).toUpperCase()}${label.slice(1)} copied`);
      }

      codeEditor.addEventListener('copied', () => notify('Theme CSS copied'));
      $('#copy-link').addEventListener('click', () => copyText(location.href, 'share link'));

      $('#download-css').addEventListener('click', () => {
        const url = URL.createObjectURL(new Blob([theme.css], { type: 'text/css' }));
        const link = Object.assign(document.createElement('a'), { href: url, download: 'tokens.css' });
        link.click();
        URL.revokeObjectURL(url);
      });

      $('#reset-theme').addEventListener('click', () => {
        config = engine.normalizeThemeConfig(engine.defaultThemeConfig);
        syncControls();
        rebuild();
      });

      syncControls();
      await rebuild();
    })();
  </script>
</Layout>
