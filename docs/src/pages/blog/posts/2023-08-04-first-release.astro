---
import Layout from '../../../layouts/Post.astro';
import { SITE_TITLE } from '../../../siteconfig';
export const title = `${SITE_TITLE} 1.0`;
export const description = `The first release of ${SITE_TITLE}: open source, customizable web components you can drop into any page.`;
export const publishedDate = '2023-08-04';
export const tags = ['release'];
---

<Layout title={title} description={description} publishedDate={publishedDate} tags={tags}>
  <p>
    Hi all! 👋 We are {SITE_TITLE}, a collective of open source and web component enthusiasts.
  </p>
  <p>
    Our goal is to give everyone a powerful, battle-tested setup for creating and sharing open source, customizable web
    components. {SITE_TITLE} 1.0 is the first step: components that work in any page without a framework dependency.
  </p>
</Layout>
