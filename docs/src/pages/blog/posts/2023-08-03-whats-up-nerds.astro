---
import Layout from '../../../layouts/Post.astro';
import { SITE_TITLE } from '../../../siteconfig';
export const title = "What's up nerds?";
export const description = `Welcome to the official ${SITE_TITLE} blog: release notes, documentation changes and examples of ${SITE_TITLE} in use.`;
export const publishedDate = '2023-08-03';
export const tags = ['announcement'];
---

<Layout title={title} description={description} publishedDate={publishedDate} tags={tags}>
  <p>Welcome one and all to the new, official {SITE_TITLE} blog.</p>
  <p>
    From now on we will post here about new releases, documentation changes, and great examples of folks using
    {SITE_TITLE}. Stay tuned for our first post on the next two updates for the project.
  </p>
</Layout>
