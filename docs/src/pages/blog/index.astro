---
import Layout from '../../layouts/WithSidebar.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../siteconfig';
import { formatPostDate, getPosts } from '../../_data/blog';
import '../../styles/layout/doc-page.scss';
import '../../styles/pages/blog.scss';

const posts = getPosts();
const description = `News and announcements for all things ${SITE_TITLE}, including new releases.`;
const sidebarItems = [{ label: 'All posts', href: '/blog/' }, ...posts.map(post => ({ label: post.title, href: post.href }))];
---

<Layout title='Blog' description={description} sidebarItems={sidebarItems}>
  <div class='doc-page'>
    <header class='doc-header'>
      <h1 class='text-display-small'>Blog</h1>
      <p class='text-body-large doc-muted'>{description}</p>
    </header>

    <section class='doc-section' aria-labelledby='posts-title'>
      <h2 class='text-headline-small' id='posts-title'>All posts</h2>
      <ul class='post-list'>
        {posts.map(post => (
          <li>
            <a class='post-card' href={post.href}>
              <h3 class='post-card-title text-title-large'>
                {post.title}
                <wc-icon name='arrow_forward' aria-hidden='true'></wc-icon>
              </h3>
              <div class='post-meta text-label-large'>
                <time datetime={post.publishedDate}>{formatPostDate(post.publishedDate)}</time>
              </div>
              <p class='text-body-large doc-muted'>{post.description}</p>
              {post.tags && post.tags.length > 0 && (
                <div class='post-tags'>
                  {post.tags.map(tag => <wc-tag size='sm'>{tag}</wc-tag>)}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <Footer />
</Layout>
