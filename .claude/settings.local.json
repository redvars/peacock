{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff)",
      "Read(src/**)",
      "Read(package.json)",
      "Bash(git ls-remote *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "defaultMode": "plan"
  }
}
