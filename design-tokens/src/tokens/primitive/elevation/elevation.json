    },
    "level5": {
      "$value": [
        { "color": "#0000004d", "offsetX": "0px", "offsetY": "4px", "blur": "4px", "spread": "0px" },
        { "color": "#00000026", "offsetX": "0px", "offsetY": "8px", "blur": "12px", "spread": "6px" }
      ]
    }
  }
}
