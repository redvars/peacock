      ]
    },
    "level1": {
      "$value": [
        { "color": "#0000004d", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#00000026", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "1px" }
      ]
    },
    "level2": {
      "$value": [
        { "color": "#0000004d", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#00000026", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "2px" }
      ]
    },
    "level3": {
      "$value": [
        { "color": "#0000004d", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" },
        { "color": "#00000026", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "3px" }
      ]
    },
    "level4": {
      "$value": [
        { "color": "#0000004d", "offsetX": "0px", "offsetY": "2px", "blur": "3px", "spread": "0px" },
        { "color": "#00000026", "offsetX": "0px", "offsetY": "6px", "blur": "10px", "spread": "4px" }
