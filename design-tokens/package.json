{
  "name": "@redvars/peacock-design-tokens",
  "version": "0.1.1",
  "description": "red:var design tokens",
  "type": "module",
  "scripts": {
    "build": "node ./bin/build-theme.mjs && npm run build:engine",
    "build:engine": "esbuild src/engine/index.mjs --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=eof --outfile=dist/theme.js",
    "test": "node --test test/",
    "deploy": "node ./bin/deployToComponents.js"
  },
  "files": [
    "dist/"
  ],
  "bugs": {
    "url": "https://github.com/redvars/design-tokens/issues"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redvars/design-tokens.git"
  },
  "private": false,
  "author": "Redvars <hello@redvars.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@material/material-color-utilities": "0.3.0",
    "@terrazzo/parser": "^0.10.5",
    "@terrazzo/plugin-css": "^0.10.4",
    "esbuild": "^0.28.2"
  }
}
